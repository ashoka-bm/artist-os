#!/usr/bin/env python3
"""Scaffold a new internal Artist OS mode file.

Artist OS exposes one public skill, `skills/artist-os/SKILL.md`. Specialized
workflows live as internal mode files under `skills/artist-os/references/` and
are loaded by path from the conductor. This compatibility command keeps its old
name, but it no longer creates or registers public skills.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import re
import sys
from pathlib import Path

_RESOLVER_PATH = Path(__file__).resolve().parent / "artist-os-paths"
_LOADER = importlib.machinery.SourceFileLoader("artist_os_paths", str(_RESOLVER_PATH))
_SPEC = importlib.util.spec_from_loader("artist_os_paths", _LOADER)
resolver = importlib.util.module_from_spec(_SPEC)
_LOADER.exec_module(resolver)

# Internal mode filenames are lowercase kebab: skills/artist-os/references/<name>.md.
_NAME_RE = re.compile(r"^[a-z][a-z0-9-]*$")

# Names that collide with public-surface or filesystem sentinel meanings.
RESERVED = {"none", "artist-os", "references"}

ANCHOR_SENTENCE = (
    "Paths like `THEORY.md` and files under `docs/`, `schemas/`, and `skills/` "
    "resolve from `$ARTIST_OS_ROOT` - the repo root in a checkout, the bundle "
    "root in a Codex install. If a referenced file is missing, run "
    "`bin/artist-os-paths doctor`."
)


def _title(name: str) -> str:
    return name.replace("-", " ").title()


def create_mode_file(root: Path, name: str) -> Path:
    """Write skills/artist-os/references/<name>.md from a lean template."""
    conductor = root / "skills" / "artist-os" / "SKILL.md"
    if not conductor.exists():
        raise OSError("missing public conductor at skills/artist-os/SKILL.md")

    references_dir = root / "skills" / "artist-os" / "references"
    references_dir.mkdir(parents=True, exist_ok=True)
    md = references_dir / f"{name}.md"
    if md.exists():
        raise FileExistsError(f"{md.relative_to(root)} already exists")

    md.write_text(
        f"# {_title(name)}\n\n"
        "TODO: author this internal Artist OS mode.\n\n"
        f"{ANCHOR_SENTENCE}\n\n"
        "## Mode Contract\n\n"
        "- Entry condition: TODO.\n"
        "- Required records: TODO.\n"
        "- Hard gates: TODO.\n"
        "- Handoff back to conductor: TODO.\n",
        encoding="utf-8",
    )
    return md


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: artist-os-new-skill <mode-name>   (name: ^[a-z][a-z0-9-]*$)")
        return 0 if argv else 2

    name = argv[0]
    if not _NAME_RE.match(name):
        print(f"FAIL  invalid mode name {name!r}; must match ^[a-z][a-z0-9-]*$", file=sys.stderr)
        return 2
    if name in RESERVED:
        print(f"FAIL  {name!r} is a reserved name; choose another", file=sys.stderr)
        return 1

    try:
        root = resolver.resolve_root()
    except resolver.ResolveError as exc:
        print(f"FAIL  {exc}", file=sys.stderr)
        return 1

    if (root / "skills" / name).exists():
        print(
            f"FAIL  skills/{name} already exists as a public skill directory; "
            "new Artist OS behavior should be an internal mode file",
            file=sys.stderr,
        )
        return 1

    try:
        md = create_mode_file(root, name)
    except (OSError, UnicodeError) as exc:
        print(f"FAIL  {exc}", file=sys.stderr)
        return 1

    print(f"created    {md.relative_to(root)}")
    print("not registered as a public skill")
    _print_todos(name)
    return 0


def _print_todos(name: str) -> None:
    print(
        "\nNEXT (author by hand - the scaffold only creates the internal mode file):\n"
        f"  1. skills/artist-os/references/{name}.md: replace the TODO body.\n"
        f"  2. skills/artist-os/SKILL.md: add the mode to the Internal mode map and phase order if it is routable.\n"
        "  3. Add or update contract tests for the mode's load-bearing gates and records.\n"
        "  Then run: bin/artist-os-lint  &&  bin/artist-os-paths doctor  &&  python3 -m unittest discover -s tests -p 'test_*.py'"
    )


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
