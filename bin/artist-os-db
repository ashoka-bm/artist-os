#!/usr/bin/env python3
"""Manage the local Artist OS SQLite library index."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import sqlite3
import sys
from collections import namedtuple
from contextlib import closing
from datetime import datetime, timezone
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from artist_os_schema_validator import ValidationError, load_json, validate
DEFAULT_LIBRARY_ROOT = REPO_ROOT / "workspace-library" / "artist-os"
SCHEMA_PATH = REPO_ROOT / "schemas" / "artist-os-library.sql"
PROJECT_SUBDIRS = [
    "projects",
    "imports",
    "exports",
]
ARTIST_LIBRARY_RELATIVE = Path("Wondermint") / "Artist Library"
WORKSPACE_LIBRARY_RELATIVE = Path(".wondermint") / "artist-os"
PROJECT_POINTER_FILENAME = ".artist-os-project.json"
PROJECT_SLUG_PATTERN = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9._-]*$")
PROJECT_ID_PATTERN = re.compile(r"^proj_[a-zA-Z0-9_-]+$")
FEEDBACK_ID_PATTERN = re.compile(r"^fb_[a-zA-Z0-9_-]+$")
LEARNING_ID_PATTERN = re.compile(r"^learn_[a-zA-Z0-9_-]+$")
PERFORMANCE_SIGNAL_ID_PATTERN = re.compile(r"^perf_[a-zA-Z0-9_-]+$")
OUTPUT_RECORD_ID_PATTERN = re.compile(r"^out_[a-zA-Z0-9_-]+$")
LEARNING_EVIDENCE_TYPES = [
    "feedback_entry",
    "performance_signal",
    "output_record",
    "review_record",
    "schema_mismatch",
    "tool_field_mismatch",
]
VISIBLE_OUTPUT_STATE_TO_ROLE = {
    "draft": "review_draft",
    "accepted": "accepted_work",
}
VISIBLE_OUTPUT_STATE_TO_SUBDIR = {
    "draft": "Drafts",
    "accepted": "Accepted",
}
ARTIFACT_KIND_TO_MEDIUM_FOLDER = {
    "image": "Images",
    "audio": "Audio",
    "text": "Writing",
    "video": "Video",
    "mixed_media_package": "Mixed Media",
}


def connect(db_path: Path) -> sqlite3.Connection:
    db_path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


# A migration is a forward, run-once delta that the idempotent baseline DDL
# cannot express (ALTER, data backfill, DROP). Migrations apply in ascending
# version order and are recorded in schema_migrations so they never run twice.
Migration = namedtuple("Migration", ["version", "name", "statements"])

# Frozen-baseline convention:
#   - The baseline is the schemas/artist-os-library.sql DDL, which seeds
#     schema_migrations versions 1 and 2. Every fresh or existing DB therefore
#     starts at {1, 2} after apply_schema().
#   - Entries here are version 3+ deltas the baseline DDL cannot express
#     (ALTER / data backfill / DROP). New additive tables/indexes go straight
#     into the baseline DDL ("CREATE ... IF NOT EXISTS" is safe on both fresh
#     and existing DBs) and must NOT get a migration entry.
#   - A migration's effect must NOT also be baked into the baseline DDL. If it
#     were, a fresh DB would already have the final shape and re-applying the
#     migration would fail.
MIGRATIONS: list[Migration] = []

# Migrations begin above the baseline seeded by schemas/artist-os-library.sql
# (versions 1 and 2). A registered migration must use a version >= this. If
# the baseline seed set ever grows, bump this in lockstep.
MIN_MIGRATION_VERSION = 3


def apply_migrations(conn: sqlite3.Connection, migrations=None) -> list[int]:
    """Apply pending forward migrations in ascending version order.

    Each migration runs inside its own SAVEPOINT so a failure mid-migration
    rolls back that migration's partial DDL/DML and leaves schema_migrations
    unchanged for it (Python's sqlite3 does not reliably wrap DDL in the
    implicit DML transaction, so the SAVEPOINT is what guarantees atomicity).
    Returns the list of versions newly applied during this call.
    """
    if migrations is None:
        migrations = MIGRATIONS

    # Validate the registry's well-formedness BEFORE touching the DB, so a
    # malformed registry fails loud (no partial writes) rather than silently
    # no-op'ing. This checks the registry only; it deliberately does NOT look at
    # what is already recorded in schema_migrations -- skipping an
    # already-applied version is the intended idempotent behaviour below.
    versions = [migration.version for migration in migrations]
    seen: set[int] = set()
    duplicates = sorted({v for v in versions if v in seen or seen.add(v)})
    if duplicates:
        raise ValueError(f"duplicate migration versions in registry: {duplicates}")
    below_baseline = sorted(v for v in versions if v < MIN_MIGRATION_VERSION)
    if below_baseline:
        raise ValueError(
            f"migration versions below the seeded baseline: {below_baseline}; "
            f"versions 1 and 2 are reserved for the schemas/artist-os-library.sql "
            f"baseline seed, so a registered migration must use a version "
            f">= MIN_MIGRATION_VERSION ({MIN_MIGRATION_VERSION})"
        )

    # Defensively ensure the ledger exists, mirroring the baseline DDL, so this
    # works even on a connection that never ran apply_schema(). This inline DDL
    # MUST stay in sync with the canonical schema_migrations definition in
    # schemas/artist-os-library.sql (currently byte-identical) -- a column change
    # to one must be mirrored in the other.
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS schema_migrations (
          version INTEGER PRIMARY KEY,
          name TEXT NOT NULL,
          applied_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
        )
        """
    )
    applied = {row[0] for row in conn.execute("SELECT version FROM schema_migrations")}

    newly_applied: list[int] = []
    for migration in sorted(migrations, key=lambda m: m.version):
        if migration.version in applied:
            continue
        conn.execute("SAVEPOINT artist_os_migration")
        try:
            for statement in migration.statements:
                conn.execute(statement)
            conn.execute(
                "INSERT INTO schema_migrations (version, name) VALUES (?, ?)",
                (migration.version, migration.name),
            )
            conn.execute("RELEASE SAVEPOINT artist_os_migration")
        except Exception:
            conn.execute("ROLLBACK TO SAVEPOINT artist_os_migration")
            conn.execute("RELEASE SAVEPOINT artist_os_migration")
            raise
        applied.add(migration.version)
        newly_applied.append(migration.version)
    return newly_applied


def apply_schema(conn: sqlite3.Connection) -> list[int]:
    schema = SCHEMA_PATH.read_text(encoding="utf-8")
    conn.executescript(schema)
    return apply_migrations(conn)


def setup_library(library_root: Path, db_path: Path) -> list[int]:
    library_root.mkdir(parents=True, exist_ok=True)
    for subdir in PROJECT_SUBDIRS:
        (library_root / subdir).mkdir(parents=True, exist_ok=True)
    with closing(connect(db_path)) as conn, conn:
        return apply_schema(conn)


def workspace_library_for_wondermint_root(wondermint_root: Path) -> Path:
    return wondermint_root / WORKSPACE_LIBRARY_RELATIVE


def artist_library_for_wondermint_root(wondermint_root: Path) -> Path:
    return wondermint_root / ARTIST_LIBRARY_RELATIVE


def default_library_root() -> Path:
    if os.environ.get("ARTIST_OS_LIBRARY_ROOT"):
        return Path(os.environ["ARTIST_OS_LIBRARY_ROOT"])
    if os.environ.get("WONDERMINT_ROOT"):
        return workspace_library_for_wondermint_root(Path(os.environ["WONDERMINT_ROOT"]))
    return DEFAULT_LIBRARY_ROOT


def library_root_for(args: argparse.Namespace) -> Path:
    if getattr(args, "library_root", None):
        return Path(args.library_root)
    if getattr(args, "wondermint_root", None):
        return workspace_library_for_wondermint_root(Path(args.wondermint_root))
    return default_library_root()


def artist_library_root_for(args: argparse.Namespace) -> Path | None:
    if getattr(args, "artist_library_root", None):
        return Path(args.artist_library_root)
    if getattr(args, "wondermint_root", None):
        return artist_library_for_wondermint_root(Path(args.wondermint_root))
    if os.environ.get("WONDERMINT_ROOT") and not getattr(args, "library_root", None):
        return artist_library_for_wondermint_root(Path(os.environ["WONDERMINT_ROOT"]))
    return None


def init_db(args: argparse.Namespace) -> None:
    db_path = db_path_for(args)
    with closing(connect(db_path)) as conn, conn:
        newly_applied = apply_schema(conn)
    print(f"initialized {db_path}")
    if newly_applied:
        print(f"applied migrations: {newly_applied}")


def setup_db(args: argparse.Namespace) -> None:
    library_root = library_root_for(args)
    db_path = db_path_for(args)
    newly_applied = setup_library(library_root, db_path)
    artist_library_root = artist_library_root_for(args)
    if artist_library_root:
        (artist_library_root / "Projects").mkdir(parents=True, exist_ok=True)
        (artist_library_root / "Personal Library").mkdir(parents=True, exist_ok=True)
    print(f"created Workspace Library folders under {library_root}")
    if artist_library_root:
        print(f"created Artist Library folders under {artist_library_root}")
    print(f"initialized {db_path}")
    if newly_applied:
        print(f"applied migrations: {newly_applied}")


def read_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def resolve_path(path_value: str | None, project_dir: Path, library_root: Path) -> Path | None:
    if not path_value:
        return None
    path = Path(path_value)
    candidates = [path]
    if not path.is_absolute():
        candidates.append(REPO_ROOT / path)
        candidates.append(project_dir / path)
        candidates.append(library_root / path)
        if path.parts[:2] == ("workspace-library", "artist-os"):
            candidates.append(library_root.joinpath(*path.parts[2:]))
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def optional_json(path_value: str | None, project_dir: Path, library_root: Path) -> dict:
    path = resolve_path(path_value, project_dir, library_root)
    if path:
        return read_json(path)
    return {}


def iter_output_record_files(paths: dict, project_dir: Path, library_root: Path) -> list[Path]:
    output_records_dir = resolve_path(paths.get("output_records_dir"), project_dir, library_root)
    if not output_records_dir or not output_records_dir.is_dir():
        return []
    return sorted(
        path
        for path in output_records_dir.rglob("*.json")
        if path.is_file()
    )


def output_artifact_row(
    project_id: str,
    output_record_path: Path,
    output_record: dict,
    library_root: Path,
) -> tuple | None:
    if output_record.get("project_id") != project_id:
        return None
    output_record_id = output_record.get("output_record_id")
    artifact = output_record.get("output_artifact") or {}
    required_artifact_fields = ("artifact_id", "artifact_kind", "uri_or_path", "mime_type")
    if not output_record_id or any(not artifact.get(field) for field in required_artifact_fields):
        return None
    origin = output_record.get("origin") or {}
    generation = output_record.get("generation") or {}
    review_state = output_record.get("review_state") or {}
    acceptance_state = output_record.get("acceptance_state") or {}
    return (
        output_record_id,
        project_id,
        relative_library_path(output_record_path, library_root),
        artifact["artifact_id"],
        artifact.get("artifact_kind"),
        artifact["uri_or_path"],
        artifact.get("mime_type"),
        origin.get("origin_type"),
        generation.get("provider"),
        generation.get("model"),
        review_state.get("review_status"),
        acceptance_state.get("output_acceptance_status"),
        output_record.get("created_at"),
    )


def event_key(payload: dict, fallback_index: int) -> tuple:
    event_id = payload.get("event_id")
    if event_id:
        return ("event_id", event_id)
    return ("row", fallback_index)


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def compact_timestamp(value: str) -> str:
    return re.sub(r"[^0-9]", "", value)[:20]


def relative_library_path(path: Path, library_root: Path) -> str:
    try:
        return str(path.relative_to(library_root))
    except ValueError:
        pass
    try:
        return str(path.resolve().relative_to(library_root.resolve()))
    except ValueError:
        return str(path)


def project_manifest_path(library_root: Path, project_id: str) -> Path:
    return library_root / "projects" / project_id / "project.json"


def load_project_manifest(library_root: Path, project_id: str) -> tuple[Path, dict]:
    validate_id(project_id, PROJECT_ID_PATTERN, "project_id")
    manifest_path = project_manifest_path(library_root, project_id)
    if not manifest_path.exists():
        raise SystemExit(f"project manifest not found: {manifest_path}")
    return manifest_path, read_json(manifest_path)


def write_project_manifest(manifest_path: Path, manifest: dict) -> None:
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def feedback_state_for(manifest: dict, project_id: str) -> dict:
    feedback_state = dict(manifest.get("feedback_state") or {})
    feedback_state.setdefault("feedback_log_path", f"projects/{project_id}/feedback-log.jsonl")
    feedback_state.setdefault("learning_review_status", "pending")
    feedback_state.setdefault("learning_reviewed_at", None)
    feedback_state.setdefault("learning_refs", [])
    feedback_state.setdefault("performance_signal_refs", [])
    return feedback_state


def dedupe_refs(refs: list[dict], id_key: str, new_ref: dict) -> list[dict]:
    filtered = [ref for ref in refs if ref.get(id_key) != new_ref[id_key]]
    filtered.append(new_ref)
    return filtered


def validate_id(value: str, pattern: re.Pattern[str], label: str) -> str:
    if not pattern.fullmatch(value):
        raise SystemExit(f"{label} must match {pattern.pattern}")
    return value


def validate_optional_id(value: str | None, pattern: re.Pattern[str], label: str) -> str | None:
    if value is None:
        return None
    return validate_id(value, pattern, label)


def require_new_record_path(path: Path, overwrite: bool) -> None:
    if path.exists() and not overwrite:
        raise SystemExit(f"record already exists: {path}; use --overwrite to replace it")


def read_feedback_entries(feedback_log_path: Path) -> list[dict]:
    if not feedback_log_path.exists():
        return []
    entries = []
    for line in feedback_log_path.read_text(encoding="utf-8").splitlines():
        if line.strip():
            entries.append(json.loads(line))
    return entries


def write_feedback_entries(feedback_log_path: Path, entries: list[dict]) -> None:
    feedback_log_path.parent.mkdir(parents=True, exist_ok=True)
    with feedback_log_path.open("w", encoding="utf-8") as handle:
        for entry in entries:
            handle.write(json.dumps(entry, sort_keys=True) + "\n")


def feedback_log_path_for(library_root: Path, manifest: dict, project_id: str) -> Path:
    feedback_state = manifest.get("feedback_state") or {}
    feedback_log_path = feedback_state.get("feedback_log_path") or f"projects/{project_id}/feedback-log.jsonl"
    path = Path(feedback_log_path)
    if path.is_absolute():
        raise SystemExit("feedback_log_path must be relative to the Workspace Library")
    library_root_resolved = library_root.resolve()
    resolved_path = (library_root / path).resolve()
    try:
        resolved_path.relative_to(library_root_resolved)
    except ValueError as exc:
        raise SystemExit("feedback_log_path must stay within the Workspace Library") from exc
    return resolved_path


def mark_feedback_entries_reviewed(
    feedback_log_path: Path,
    feedback_ids: list[str] | None,
    classification_status: str,
) -> bool:
    entries = read_feedback_entries(feedback_log_path)
    if not entries:
        return True
    ids = set(feedback_ids or [])
    for entry in entries:
        if not ids or entry.get("feedback_id") in ids:
            entry["classification_status"] = classification_status
            entry["learning_review_status"] = "complete"
    write_feedback_entries(feedback_log_path, entries)
    return not any(entry.get("learning_review_status") == "pending" for entry in entries)


def resolve_artist_library_path(
    path_value: str | None,
    artist_library_root: Path | None,
    visible_project_dir: Path | None = None,
) -> Path | None:
    if not path_value:
        return None
    path = Path(path_value)
    if path.is_absolute():
        return path
    if artist_library_root:
        if path.parts[:3] == ("Wondermint", "Artist Library", "Projects"):
            return artist_library_root.parents[1].joinpath(*path.parts)
        if path.parts[:1] == ("Projects",):
            return artist_library_root.joinpath(*path.parts)
    repo_candidate = REPO_ROOT / path
    if repo_candidate.exists():
        return repo_candidate
    direct_candidate = Path.cwd() / path
    if direct_candidate.exists():
        return direct_candidate
    if visible_project_dir:
        return visible_project_dir / path
    return None


def pointer_state(pointer_path: Path | None, project_id: str) -> tuple[str, str | None]:
    if not pointer_path or not pointer_path.exists():
        return ("missing", None)
    try:
        pointer = read_json(pointer_path)
    except (OSError, json.JSONDecodeError):
        return ("invalid", None)
    if not isinstance(pointer, dict):
        return ("invalid", None)
    pointer_project_id = pointer.get("project_id")
    if not isinstance(pointer_project_id, str):
        return ("invalid", None)
    if pointer_project_id != project_id:
        return ("retargeted", pointer_project_id)
    return ("present", pointer_project_id)


def refreshed_artist_library_state(
    manifest: dict,
    artist_library_root: Path | None,
    checked_at: str,
) -> dict | None:
    artist_library = manifest.get("artist_library")
    if not artist_library:
        return None

    refreshed = dict(artist_library)
    project_id = manifest["project_id"]
    project_dir = resolve_artist_library_path(refreshed.get("project_dir"), artist_library_root)
    pointer_path = resolve_artist_library_path(
        refreshed.get("project_pointer_path"),
        artist_library_root,
        project_dir if refreshed.get("project_pointer_path") == PROJECT_POINTER_FILENAME else None,
    )

    if not project_dir and not pointer_path:
        return refreshed

    refreshed["last_checked_at"] = checked_at
    if project_dir and not project_dir.exists():
        refreshed["visible_state"] = "visible_missing"
        refreshed["project_pointer_state"] = "missing"
        refreshed["project_pointer_project_id"] = None
    elif pointer_path:
        current_pointer_state, pointer_project_id = pointer_state(pointer_path, project_id)
        refreshed["project_pointer_state"] = current_pointer_state
        refreshed["project_pointer_project_id"] = pointer_project_id
        refreshed["visible_state"] = "present" if current_pointer_state == "present" else "visible_missing"

    user_facing_files = []
    for file_ref in refreshed.get("user_facing_files", []):
        checked_file_ref = dict(file_ref)
        file_path = resolve_artist_library_path(
            checked_file_ref.get("path"),
            artist_library_root,
            project_dir,
        )
        if file_path and not file_path.exists():
            checked_file_ref["status"] = "missing"
            checked_file_ref["updated_at"] = checked_at
        user_facing_files.append(checked_file_ref)
    if user_facing_files:
        refreshed["user_facing_files"] = user_facing_files
    return refreshed


def upsert_manifest(
    conn: sqlite3.Connection,
    manifest_path: Path,
    library_root: Path,
    artist_library_root: Path | None = None,
    checked_at: str | None = None,
) -> None:
    manifest = read_json(manifest_path)
    checked_at = checked_at or datetime.now(timezone.utc).isoformat()
    project_id = manifest["project_id"]
    paths = manifest.get("paths", {})
    decisions = manifest.get("decisions", {})
    project_dir = paths.get("project_dir", str(manifest_path.parent))

    conn.execute(
        """
        INSERT INTO projects (
          project_id, title, status, current_stage, summary, project_dir,
          manifest_path, created_at, updated_at
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
        ON CONFLICT(project_id) DO UPDATE SET
          title = excluded.title,
          status = excluded.status,
          current_stage = excluded.current_stage,
          summary = excluded.summary,
          project_dir = excluded.project_dir,
          manifest_path = excluded.manifest_path,
          created_at = excluded.created_at,
          updated_at = excluded.updated_at
        """,
        (
            project_id,
            manifest["title"],
            manifest["status"],
            manifest["current_stage"],
            manifest.get("summary"),
            project_dir,
            str(manifest_path),
            manifest["created_at"],
            manifest["updated_at"],
        ),
    )

    conn.execute("DELETE FROM project_paths WHERE project_id = ?", (project_id,))
    conn.executemany(
        "INSERT INTO project_paths (project_id, path_key, path_value) VALUES (?, ?, ?)",
        [(project_id, key, value) for key, value in paths.items()],
    )

    artist_library = refreshed_artist_library_state(manifest, artist_library_root, checked_at)
    conn.execute("DELETE FROM project_visible_state WHERE project_id = ?", (project_id,))
    conn.execute("DELETE FROM artist_library_files WHERE project_id = ?", (project_id,))
    if artist_library:
        conn.execute(
            """
            INSERT INTO project_visible_state (
              project_id, artist_library_project_dir, project_pointer_path,
              project_pointer_state, project_pointer_project_id, visible_state,
              last_checked_at, payload_json
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                project_id,
                artist_library.get("project_dir"),
                artist_library.get("project_pointer_path"),
                artist_library.get("project_pointer_state"),
                artist_library.get("project_pointer_project_id"),
                artist_library["visible_state"],
                artist_library.get("last_checked_at"),
                json.dumps(artist_library, sort_keys=True),
            ),
        )
        conn.executemany(
            """
            INSERT INTO artist_library_files (
              project_id, path, file_role, status, output_record_id, updated_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            [
                (
                    project_id,
                    file_ref["path"],
                    file_ref["file_role"],
                    file_ref["status"],
                    file_ref.get("output_record_id"),
                    file_ref.get("updated_at"),
                )
                for file_ref in artist_library.get("user_facing_files", [])
            ],
        )

    feedback_state = manifest.get("feedback_state")
    conn.execute("DELETE FROM project_feedback_state WHERE project_id = ?", (project_id,))
    conn.execute("DELETE FROM learning_refs WHERE project_id = ?", (project_id,))
    conn.execute("DELETE FROM performance_signal_refs WHERE project_id = ?", (project_id,))
    if feedback_state:
        conn.execute(
            """
            INSERT INTO project_feedback_state (
              project_id, feedback_log_path, learning_review_status,
              learning_reviewed_at, payload_json
            )
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                project_id,
                feedback_state.get("feedback_log_path"),
                feedback_state["learning_review_status"],
                feedback_state.get("learning_reviewed_at"),
                json.dumps(feedback_state, sort_keys=True),
            ),
        )
        conn.executemany(
            """
            INSERT INTO learning_refs (project_id, ref_id, learning_type, path, status)
            VALUES (?, ?, ?, ?, ?)
            """,
            [
                (project_id, ref["ref_id"], ref["learning_type"], ref["path"], ref["status"])
                for ref in feedback_state.get("learning_refs", [])
            ],
        )
        conn.executemany(
            """
            INSERT INTO performance_signal_refs (project_id, signal_id, path, status)
            VALUES (?, ?, ?, ?)
            """,
            [
                (project_id, ref["signal_id"], ref["path"], ref["status"])
                for ref in feedback_state.get("performance_signal_refs", [])
            ],
        )

    # Mirror the artist_library / feedback_state handling above: clear the row,
    # then insert only when the manifest actually carries the decision data. The
    # four *_status columns are NOT NULL, so an empty or partial `decisions`
    # object must skip the row rather than bracket-access missing keys (KeyError)
    # or insert NULLs (IntegrityError).
    conn.execute("DELETE FROM project_decisions WHERE project_id = ?", (project_id,))
    required_decision_status = (
        "interpretation_status",
        "symbology_status",
        "style_status",
        "detail_status",
    )
    if decisions and all(key in decisions for key in required_decision_status):
        conn.execute(
            """
            INSERT INTO project_decisions (
              project_id, interpretation_status, symbology_status, style_status,
              detail_status, selected_symbology, presentation_mode, selected_style,
              selected_detail_mode
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                project_id,
                decisions["interpretation_status"],
                decisions["symbology_status"],
                decisions["style_status"],
                decisions["detail_status"],
                decisions.get("selected_symbology"),
                decisions.get("presentation_mode"),
                decisions.get("selected_style"),
                decisions.get("selected_detail_mode"),
            ),
        )

    conn.execute("DELETE FROM assets WHERE project_id = ?", (project_id,))
    project_dir_path = Path(project_dir)
    for asset in manifest.get("assets", []):
        sidecar = optional_json(asset.get("metadata_path"), project_dir_path, library_root)
        provenance = sidecar.get("provenance", {})
        generation = sidecar.get("generation", {})
        conn.execute(
            """
            INSERT INTO assets (
              asset_id, project_id, asset_type, stage, path, metadata_path,
              status, created_at, critique_status, origin, provider, model,
              source_record_id, brief_id, prompt_plan_id, visual_board_type,
              prompt_variant_id
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                asset["asset_id"],
                project_id,
                asset["asset_type"],
                asset["stage"],
                asset["path"],
                asset["metadata_path"],
                asset["status"],
                asset.get("created_at"),
                sidecar.get("critique_status"),
                provenance.get("origin"),
                generation.get("provider"),
                generation.get("model"),
                provenance.get("source_record_id"),
                provenance.get("brief_id"),
                provenance.get("prompt_plan_id"),
                provenance.get("visual_board_type"),
                provenance.get("prompt_variant_id"),
            ),
        )

    conn.execute("DELETE FROM records WHERE project_id = ?", (project_id,))
    conn.execute("DELETE FROM output_artifacts WHERE project_id = ?", (project_id,))
    record_keys = {
        "source_record": "source_record",
        "reference_text": "reference_text",
        "artist_meaning": "artist_meaning",
        "meaning_interview": "meaning_interview",
        "transformation_brief": "transformation_brief",
        "beat_plan": "beat_plan",
        "image_medium_plan": "image_medium_plan",
        "sound_medium_plan": "sound_medium_plan",
        "interpretation_gate": "interpretation_gate",
        "symbology_gate": "symbology_gate",
        "style_gate": "style_gate",
        "detail_gate": "detail_gate",
        "creative_brief_draft": "creative_brief_draft",
        "creative_brief_record": "creative_brief_record",
        "prompt_plan": "prompt_plan",
        "prompt_branch_set": "prompt_branch_set",
        "output_records_dir": "output_records_dir",
    }
    for key, record_type in record_keys.items():
        value = paths.get(key)
        if value:
            conn.execute(
                """
                INSERT INTO records (project_id, record_type, path, status, updated_at)
                VALUES (?, ?, ?, ?, ?)
                """,
                (project_id, record_type, value, None, manifest["updated_at"]),
            )

    for output_record_path in iter_output_record_files(paths, project_dir_path, library_root):
        try:
            output_record = read_json(output_record_path)
        except (OSError, json.JSONDecodeError):
            continue
        if output_record.get("project_id") != project_id or not output_record.get("output_record_id"):
            continue
        record_path = relative_library_path(output_record_path, library_root)
        conn.execute(
            """
            INSERT INTO records (project_id, record_type, path, status, updated_at)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                project_id,
                "output_record",
                record_path,
                (output_record.get("acceptance_state") or {}).get("output_acceptance_status"),
                output_record.get("created_at") or manifest["updated_at"],
            ),
        )
        artifact_row = output_artifact_row(project_id, output_record_path, output_record, library_root)
        if artifact_row:
            conn.execute(
                """
                INSERT INTO output_artifacts (
                  output_record_id, project_id, output_record_path, artifact_id,
                  artifact_kind, uri_or_path, mime_type, origin_type, provider,
                  model, review_status, acceptance_status, created_at
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(output_record_id) DO UPDATE SET
                  project_id = excluded.project_id,
                  output_record_path = excluded.output_record_path,
                  artifact_id = excluded.artifact_id,
                  artifact_kind = excluded.artifact_kind,
                  uri_or_path = excluded.uri_or_path,
                  mime_type = excluded.mime_type,
                  origin_type = excluded.origin_type,
                  provider = excluded.provider,
                  model = excluded.model,
                  review_status = excluded.review_status,
                  acceptance_status = excluded.acceptance_status,
                  created_at = excluded.created_at
                """,
                artifact_row,
            )

    events_path_value = paths.get("events")
    if events_path_value:
        events_path = resolve_path(events_path_value, project_dir_path, library_root)
        conn.execute("DELETE FROM events WHERE project_id = ?", (project_id,))
        if events_path and events_path.exists():
            for index, line in enumerate(events_path.read_text(encoding="utf-8").splitlines(), 1):
                if not line.strip():
                    continue
                payload = json.loads(line)
                key_type, key_value = event_key(payload, index)
                event_id = key_value if key_type == "event_id" else None
                conn.execute(
                    """
                    INSERT INTO events (
                      event_id, project_id, occurred_at, stage, event_type,
                      summary, payload_json
                    )
                    VALUES (?, ?, ?, ?, ?, ?, ?)
                    """,
                    (
                        event_id,
                        payload.get("project_id", project_id),
                        payload.get("occurred_at") or payload.get("created_at") or payload.get("timestamp"),
                        payload.get("stage"),
                        payload.get("event_type") or payload.get("type"),
                        payload.get("summary"),
                        json.dumps(payload, sort_keys=True),
                    ),
                )


def sync_db(args: argparse.Namespace) -> None:
    library_root = library_root_for(args)
    db_path = db_path_for(args)
    artist_library_root = artist_library_root_for(args)
    checked_at = datetime.now(timezone.utc).isoformat()
    manifests = sorted((library_root / "projects").glob("*/project.json"))
    with closing(connect(db_path)) as conn, conn:
        apply_schema(conn)
        found_project_ids = set()
        for manifest_path in manifests:
            upsert_manifest(conn, manifest_path, library_root, artist_library_root, checked_at)
            found_project_ids.add(read_json(manifest_path)["project_id"])
        if found_project_ids:
            placeholders = ",".join("?" for _ in found_project_ids)
            conn.execute(
                f"""
                UPDATE projects
                SET status = 'missing',
                    updated_at = ?
                WHERE project_id NOT IN ({placeholders})
                  AND status != 'archived'
                """,
                (checked_at, *sorted(found_project_ids)),
            )
        else:
            conn.execute(
                """
                UPDATE projects
                SET status = 'missing',
                    updated_at = ?
                WHERE status != 'archived'
                """,
                (checked_at,),
            )
    print(f"synced {len(manifests)} project(s) into {db_path}")


def validate_record(record: dict, schema_name: str) -> None:
    """Validate a record against its schema before persisting it.

    Refuses to write malformed records so the durable store never
    accumulates data that violates the repo's schemas.
    """
    schema = load_json(REPO_ROOT / "schemas" / schema_name)
    try:
        validate(record, schema, schema)
    except ValidationError as exc:
        raise SystemExit(f"refusing to write malformed {schema_name}: {exc}")


def add_feedback(args: argparse.Namespace) -> None:
    library_root = library_root_for(args)
    manifest_path, manifest = load_project_manifest(library_root, args.project_id)
    received_at = utc_now()
    feedback_id = args.feedback_id or f"fb_{args.project_id.removeprefix('proj_')}_{compact_timestamp(received_at)}"
    validate_id(feedback_id, FEEDBACK_ID_PATTERN, "feedback_id")
    output_record_id = validate_optional_id(args.output_record_id, OUTPUT_RECORD_ID_PATTERN, "output_record_id")
    feedback_log_path = feedback_log_path_for(library_root, manifest, args.project_id)
    feedback_log_path.parent.mkdir(parents=True, exist_ok=True)
    existing_ids = {entry.get("feedback_id") for entry in read_feedback_entries(feedback_log_path)}
    if feedback_id in existing_ids:
        raise SystemExit(f"feedback_id already exists in {feedback_log_path}: {feedback_id}")
    entry = {
        "feedback_id": feedback_id,
        "project_id": args.project_id,
        "received_at": received_at,
        "source": args.source,
        "stage": args.stage,
        "output_record_id": output_record_id,
        "feedback_text": args.feedback,
        "classification_status": "unclassified",
        "learning_review_status": "pending",
        "notes": args.notes,
    }
    validate_record(entry, "project-feedback-log-entry.schema.json")
    with feedback_log_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")

    feedback_state = feedback_state_for(manifest, args.project_id)
    feedback_state["feedback_log_path"] = relative_library_path(feedback_log_path, library_root)
    feedback_state["learning_review_status"] = "pending"
    feedback_state["learning_reviewed_at"] = None
    manifest["feedback_state"] = feedback_state
    manifest["updated_at"] = received_at
    write_project_manifest(manifest_path, manifest)
    sync_db(args)
    print(f"appended feedback {feedback_id}")


def add_learning(args: argparse.Namespace) -> None:
    validate_id(args.learning_id, LEARNING_ID_PATTERN, "learning_id")
    if len(args.learning_rule) > 600:
        raise SystemExit("learning_rule must be 600 characters or fewer")
    evidence_ref_values = args.evidence_ref or []
    if not evidence_ref_values:
        raise SystemExit("add-learning requires at least one --evidence-ref")
    if args.evidence_type == "feedback_entry":
        for evidence_ref in evidence_ref_values:
            validate_id(evidence_ref, FEEDBACK_ID_PATTERN, "evidence_ref")
    library_root = library_root_for(args)
    manifest_path, manifest = load_project_manifest(library_root, args.project_id)
    now = utc_now()
    learning_path = library_root / "personal-library" / "learnings" / f"{args.learning_id}.json"
    learning_path.parent.mkdir(parents=True, exist_ok=True)
    require_new_record_path(learning_path, args.overwrite)
    evidence_refs = [
        {
            "evidence_type": args.evidence_type,
            "ref": evidence_ref,
            "summary": args.evidence_summary or "Recorded as learning evidence.",
        }
        for evidence_ref in evidence_ref_values
    ]
    record = {
        "learning_id": args.learning_id,
        "learning_type": args.learning_type,
        "status": "active",
        "learning_rule": args.learning_rule,
        "scope": args.scope,
        "source_project_ids": [args.project_id],
        "evidence_refs": evidence_refs,
        "promotion_state": {
            "occurrence_count": args.occurrence_count,
            "promotion_reason": args.promotion_reason,
        },
        "created_at": now,
        "updated_at": now,
    }
    validate_record(record, "learning-record.schema.json")
    learning_path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")

    feedback_state = feedback_state_for(manifest, args.project_id)
    if args.mark_review_complete and args.evidence_type == "feedback_entry":
        all_feedback_reviewed = mark_feedback_entries_reviewed(
            feedback_log_path_for(library_root, manifest, args.project_id),
            evidence_ref_values,
            "applied",
        )
        feedback_state["learning_review_status"] = "complete" if all_feedback_reviewed else "pending"
        feedback_state["learning_reviewed_at"] = now if all_feedback_reviewed else None
    feedback_state["learning_refs"] = dedupe_refs(
        feedback_state.get("learning_refs", []),
        "ref_id",
        {
            "ref_id": args.learning_id,
            "learning_type": args.learning_type,
            "path": relative_library_path(learning_path, library_root),
            "status": "active",
        },
    )
    manifest["feedback_state"] = feedback_state
    manifest["updated_at"] = now
    write_project_manifest(manifest_path, manifest)
    sync_db(args)
    print(f"wrote learning record {learning_path}")


def parse_metric_value(raw_value: str) -> float | str:
    try:
        return float(raw_value)
    except ValueError:
        return raw_value


def add_performance_signal(args: argparse.Namespace) -> None:
    validate_id(args.signal_id, PERFORMANCE_SIGNAL_ID_PATTERN, "signal_id")
    output_record_id = validate_optional_id(args.output_record_id, OUTPUT_RECORD_ID_PATTERN, "output_record_id")
    library_root = library_root_for(args)
    manifest_path, manifest = load_project_manifest(library_root, args.project_id)
    now = utc_now()
    signal_path = library_root / "personal-library" / "performance-signals" / f"{args.signal_id}.json"
    signal_path.parent.mkdir(parents=True, exist_ok=True)
    require_new_record_path(signal_path, args.overwrite)
    record = {
        "signal_id": args.signal_id,
        "project_id": args.project_id,
        "output_record_id": output_record_id,
        "captured_at": now,
        "source": args.source,
        "metric_name": args.metric_name,
        "metric_value": parse_metric_value(args.metric_value),
        "signal_direction": args.signal_direction,
        "evidence_weight": "equal_to_artist_feedback",
        "notes": args.notes,
    }
    validate_record(record, "performance-signal.schema.json")
    signal_path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")

    feedback_state = feedback_state_for(manifest, args.project_id)
    feedback_state["performance_signal_refs"] = dedupe_refs(
        feedback_state.get("performance_signal_refs", []),
        "signal_id",
        {
            "signal_id": args.signal_id,
            "path": relative_library_path(signal_path, library_root),
            "status": "active",
        },
    )
    manifest["feedback_state"] = feedback_state
    manifest["updated_at"] = now
    write_project_manifest(manifest_path, manifest)
    sync_db(args)
    print(f"wrote performance signal {signal_path}")


def mark_learning_review_complete(args: argparse.Namespace) -> None:
    library_root = library_root_for(args)
    manifest_path, manifest = load_project_manifest(library_root, args.project_id)
    now = utc_now()
    feedback_state = feedback_state_for(manifest, args.project_id)
    all_feedback_reviewed = mark_feedback_entries_reviewed(
        feedback_log_path_for(library_root, manifest, args.project_id),
        args.feedback_id,
        args.classification_status,
    )
    feedback_state["learning_review_status"] = "complete" if all_feedback_reviewed else "pending"
    feedback_state["learning_reviewed_at"] = now if all_feedback_reviewed else None
    manifest["feedback_state"] = feedback_state
    manifest["updated_at"] = now
    write_project_manifest(manifest_path, manifest)
    sync_db(args)
    print(f"marked learning review complete for {args.project_id}")


def pending_learning_reviews(args: argparse.Namespace) -> None:
    with closing(connect(db_path_for(args))) as conn, conn:
        apply_schema(conn)
        rows = conn.execute(
            """
            SELECT p.project_id, p.title, p.updated_at, f.feedback_log_path
            FROM project_feedback_state f
            JOIN projects p ON p.project_id = f.project_id
            WHERE f.learning_review_status = 'pending'
            ORDER BY p.updated_at DESC
            """
        ).fetchall()
    for row in rows:
        print("\t".join(str(value or "") for value in row))


def learnings_report(args: argparse.Namespace) -> None:
    """Close-out summary: per-project learning-review state, linked learnings, and
    performance signals, ending with the next action. Read-only."""
    with closing(connect(db_path_for(args))) as conn, conn:
        apply_schema(conn)
        if args.project_id:
            rows = conn.execute(
                "SELECT project_id, title, updated_at FROM projects WHERE project_id = ?",
                (args.project_id,),
            ).fetchall()
            if not rows:
                raise SystemExit(f"no indexed project {args.project_id!r}; run `artist-os-db sync` first")
        else:
            rows = conn.execute(
                "SELECT project_id, title, updated_at FROM projects ORDER BY updated_at DESC"
            ).fetchall()
        if not rows:
            print("no indexed projects; run `artist-os-db sync` first")
            return

        pending = complete = not_applicable = no_feedback = 0
        for project_id, title, _updated_at in rows:
            state = conn.execute(
                "SELECT learning_review_status, learning_reviewed_at FROM project_feedback_state WHERE project_id = ?",
                (project_id,),
            ).fetchone()
            status = state[0] if state else "none"
            reviewed_at = state[1] if state else None
            if status == "pending":
                pending += 1
            elif status == "complete":
                complete += 1
            elif status == "not_applicable":
                not_applicable += 1
            else:  # no project_feedback_state row -> review=none
                no_feedback += 1
            learnings = conn.execute(
                "SELECT ref_id, learning_type, status FROM learning_refs WHERE project_id = ? ORDER BY ref_id",
                (project_id,),
            ).fetchall()
            signals = conn.execute(
                "SELECT signal_id, status FROM performance_signal_refs WHERE project_id = ? ORDER BY signal_id",
                (project_id,),
            ).fetchall()

            header = f"{project_id}  [{title or 'untitled'}]  review={status}"
            if reviewed_at:
                header += f"  reviewed_at={reviewed_at}"
            print(header)
            for ref_id, learning_type, ref_status in learnings:
                print(f"    learning  {ref_id}  ({learning_type}, {ref_status})")
            for signal_id, ref_status in signals:
                print(f"    signal    {signal_id}  ({ref_status})")
            if not learnings and not signals and status in ("none", None):
                print("    (no feedback, learnings, or signals recorded)")

        if pending:
            print(
                f"\n{pending} project(s) await learning review — capture a learning with "
                "`add-learning` or close it with `mark-learning-review-complete`."
            )
        else:
            parts = []
            if complete:
                parts.append(f"{complete} complete")
            if not_applicable:
                parts.append(f"{not_applicable} not applicable")
            if no_feedback:
                parts.append(f"{no_feedback} with no feedback yet")
            detail = f" ({', '.join(parts)})" if parts else ""
            print(f"\nno projects await a learning review{detail}.")


def project_pointer_payload(project_id: str, workspace_root_hint: str | None) -> dict:
    validate_id(project_id, PROJECT_ID_PATTERN, "project_id")
    payload = {
        "schema_version": 1,
        "project_id": project_id,
        "created_by": "artist-os",
    }
    if workspace_root_hint:
        payload["workspace_root_hint"] = workspace_root_hint
    return payload


def project_readme(title: str, project_id: str, summary: str | None, status: str | None) -> str:
    lines = [
        f"# {title}",
        "",
        "This folder contains Artist OS files intended for artist review.",
        "",
        f"- Project id: `{project_id}`",
    ]
    if status:
        lines.append(f"- Status: {status}")
    if summary:
        lines.extend(["", "## Summary", "", summary])
    lines.extend([
        "",
        "## Resume",
        "",
        "Ask Artist OS to resume this project from this folder. Internal project state lives in the sibling `.wondermint` Workspace Library.",
        "",
    ])
    return "\n".join(lines)


def validate_project_slug(project_slug: str) -> str:
    if not PROJECT_SLUG_PATTERN.fullmatch(project_slug):
        raise SystemExit(
            "project_slug must be one folder name using letters, numbers, dots, underscores, or hyphens"
        )
    return project_slug


def write_project_pointer(pointer_path: Path, pointer: dict, overwrite: bool) -> None:
    if pointer_path.exists() and not overwrite:
        try:
            existing = read_json(pointer_path)
        except json.JSONDecodeError as exc:
            raise SystemExit(
                f"Project Pointer already exists but is not valid JSON: {pointer_path}; use --overwrite-pointer to replace it"
            ) from exc
        if not isinstance(existing, dict):
            raise SystemExit(
                f"Project Pointer already exists but is not a JSON object: {pointer_path}; use --overwrite-pointer to replace it"
            )
        if existing.get("project_id") != pointer["project_id"]:
            raise SystemExit(
                f"Project Pointer already links to {existing.get('project_id')}; use --overwrite-pointer to replace it"
            )
        return
    pointer_path.write_text(json.dumps(pointer, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def visible_project_ref(path: Path, wondermint_root: Path | None, artist_library_root: Path) -> str:
    if wondermint_root:
        try:
            return str(path.relative_to(wondermint_root))
        except ValueError:
            pass
    try:
        return str(path.relative_to(artist_library_root.parent.parent))
    except ValueError:
        return str(path)


def visible_filename(value: str) -> str:
    cleaned = re.sub(r"[^a-zA-Z0-9._ -]+", "-", value).strip(" .-")
    if not cleaned:
        raise SystemExit("visible filename must contain at least one safe character")
    return cleaned


def visible_output_ref(
    path: Path,
    wondermint_root: Path | None,
    artist_library_root: Path,
) -> str:
    return visible_project_ref(path, wondermint_root, artist_library_root)


def read_output_record_by_id(
    manifest: dict,
    output_record_id: str,
    project_dir: Path,
    library_root: Path,
) -> tuple[Path, dict]:
    for output_record_path in iter_output_record_files(manifest.get("paths", {}), project_dir, library_root):
        try:
            output_record = read_json(output_record_path)
        except (OSError, json.JSONDecodeError):
            continue
        if output_record.get("output_record_id") == output_record_id:
            return output_record_path, output_record
    raise SystemExit(f"output record not found under output_records_dir: {output_record_id}")


def require_visible_artist_library_state(manifest: dict) -> dict:
    artist_library = manifest.get("artist_library") or {}
    if artist_library.get("visible_state") != "present" or not artist_library.get("project_dir"):
        raise SystemExit(
            "project has no present Artist Library folder; run link-visible-project first"
        )
    return artist_library


def artifact_source_path(output_record: dict, project_dir: Path, library_root: Path) -> Path:
    artifact = output_record.get("output_artifact") or {}
    source = resolve_path(artifact.get("uri_or_path"), project_dir, library_root)
    if not source or not source.is_file():
        raise SystemExit(f"output artifact file not found: {artifact.get('uri_or_path')}")
    return source


def dedupe_user_facing_file_refs(files: list[dict], new_ref: dict) -> list[dict]:
    filtered = [file_ref for file_ref in files if file_ref.get("path") != new_ref["path"]]
    filtered.append(new_ref)
    return filtered


def publish_visible_output(args: argparse.Namespace) -> None:
    validate_id(args.project_id, PROJECT_ID_PATTERN, "project_id")
    output_record_id = validate_id(args.output_record_id, OUTPUT_RECORD_ID_PATTERN, "output_record_id")
    library_root = library_root_for(args)
    artist_library_root = artist_library_root_for(args)
    if not artist_library_root:
        raise SystemExit("publish-visible-output requires --wondermint-root, WONDERMINT_ROOT, or --artist-library-root")
    manifest_path, manifest = load_project_manifest(library_root, args.project_id)
    artist_library = require_visible_artist_library_state(manifest)
    project_dir = Path(manifest.get("paths", {}).get("project_dir", manifest_path.parent))
    output_record_path, output_record = read_output_record_by_id(
        manifest,
        output_record_id,
        project_dir,
        library_root,
    )
    artifact = output_record.get("output_artifact") or {}
    artifact_kind = artifact.get("artifact_kind")
    medium_folder = args.medium_folder or ARTIFACT_KIND_TO_MEDIUM_FOLDER.get(artifact_kind)
    if not medium_folder:
        raise SystemExit(f"no default visible medium folder for artifact kind: {artifact_kind}")
    medium_folder = visible_filename(medium_folder)
    state_dir = VISIBLE_OUTPUT_STATE_TO_SUBDIR[args.state]
    source_path = artifact_source_path(output_record, project_dir, library_root)
    extension = source_path.suffix or Path(artifact.get("uri_or_path", "")).suffix
    requested_filename = args.filename or f"{output_record_id}{extension}"
    filename = visible_filename(requested_filename)
    if extension and not filename.endswith(extension):
        filename = f"{filename}{extension}"

    wondermint_root = Path(args.wondermint_root) if getattr(args, "wondermint_root", None) else None
    visible_project_dir = resolve_artist_library_path(
        artist_library["project_dir"],
        artist_library_root,
    )
    if not visible_project_dir:
        raise SystemExit(f"visible project folder cannot be resolved: {artist_library['project_dir']}")
    destination_dir = visible_project_dir / medium_folder / state_dir
    destination_dir.mkdir(parents=True, exist_ok=True)
    destination_path = destination_dir / filename
    if destination_path.exists() and not args.overwrite:
        raise SystemExit(f"visible output already exists: {destination_path}; use --overwrite to replace it")
    shutil.copy2(source_path, destination_path)

    now = utc_now()
    new_ref = {
        "path": visible_output_ref(destination_path, wondermint_root, artist_library_root),
        "file_role": VISIBLE_OUTPUT_STATE_TO_ROLE[args.state],
        "status": "current",
        "output_record_id": output_record_id,
        "updated_at": now,
    }
    artist_library["user_facing_files"] = dedupe_user_facing_file_refs(
        artist_library.get("user_facing_files", []),
        new_ref,
    )
    artist_library["visible_state"] = "present"
    artist_library["last_checked_at"] = now
    manifest["artist_library"] = artist_library
    manifest["updated_at"] = now
    write_project_manifest(manifest_path, manifest)

    events_path = resolve_path(manifest.get("paths", {}).get("events"), project_dir, library_root)
    if events_path:
        event = {
            "event_id": f"evt_{args.project_id.removeprefix('proj_')}_{compact_timestamp(now)}",
            "project_id": args.project_id,
            "event_type": "visible_output_published",
            "stage": "output_record",
            "created_at": now,
            "record_path": relative_library_path(output_record_path, library_root),
            "details": f"Published {output_record_id} to visible Artist Library path {new_ref['path']}.",
        }
        with events_path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, sort_keys=True) + "\n")

    sync_db(args)
    print(f"published visible output {destination_path}")


def update_visible_project_manifest(
    args: argparse.Namespace,
    artist_library_root: Path,
    project_dir: Path,
    pointer_path: Path,
    readme_path: Path,
) -> bool:
    has_workspace_root = (
        getattr(args, "library_root", None)
        or getattr(args, "wondermint_root", None)
        or os.environ.get("ARTIST_OS_LIBRARY_ROOT")
        or os.environ.get("WONDERMINT_ROOT")
    )
    if not has_workspace_root:
        return False

    library_root = library_root_for(args)
    manifest_path = project_manifest_path(library_root, args.project_id)
    if not manifest_path.exists():
        return False

    now = utc_now()
    manifest = read_json(manifest_path)
    project_id = manifest.get("project_id")
    if project_id != args.project_id:
        raise SystemExit(f"project manifest id mismatch: expected {args.project_id}, found {project_id}")

    wondermint_root = Path(args.wondermint_root) if getattr(args, "wondermint_root", None) else None
    current_pointer_state, pointer_project_id = pointer_state(pointer_path, args.project_id)
    manifest["artist_library"] = {
        "project_dir": visible_project_ref(project_dir, wondermint_root, artist_library_root),
        "project_pointer_path": visible_project_ref(pointer_path, wondermint_root, artist_library_root),
        "project_pointer_state": current_pointer_state,
        "project_pointer_project_id": pointer_project_id,
        "visible_state": "present" if current_pointer_state == "present" else "visible_missing",
        "last_checked_at": now,
        "user_facing_files": [
            {
                "path": visible_project_ref(readme_path, wondermint_root, artist_library_root),
                "file_role": "readable_summary",
                "status": "current" if readme_path.exists() else "missing",
                "updated_at": now,
            }
        ],
    }
    manifest["updated_at"] = now
    write_project_manifest(manifest_path, manifest)
    sync_db(args)
    return True


def link_visible_project(args: argparse.Namespace) -> None:
    artist_library_root = artist_library_root_for(args)
    if not artist_library_root:
        raise SystemExit("link-visible-project requires --wondermint-root, WONDERMINT_ROOT, or --artist-library-root")
    project_slug = validate_project_slug(args.project_slug)
    project_dir = artist_library_root / "Projects" / project_slug
    project_dir.mkdir(parents=True, exist_ok=True)

    pointer_path = project_dir / PROJECT_POINTER_FILENAME
    pointer = project_pointer_payload(args.project_id, args.workspace_root_hint)
    write_project_pointer(pointer_path, pointer, args.overwrite_pointer)

    readme_path = project_dir / "README.md"
    if not readme_path.exists() or args.overwrite_readme:
        readme_path.write_text(
            project_readme(args.title or args.project_slug, args.project_id, args.summary, args.status),
            encoding="utf-8",
        )

    update_visible_project_manifest(args, artist_library_root, project_dir, pointer_path, readme_path)
    print(f"linked Artist Library project folder at {project_dir}")
    print(f"wrote Project Pointer at {pointer_path}")


def list_projects(args: argparse.Namespace) -> None:
    with closing(connect(db_path_for(args))) as conn, conn:
        apply_schema(conn)
        rows = conn.execute(
            """
            SELECT project_id, status, current_stage, updated_at, title
            FROM projects
            ORDER BY updated_at DESC
            """
        ).fetchall()
    for row in rows:
        print("\t".join(str(value or "") for value in row))


def show_project(args: argparse.Namespace) -> None:
    with closing(connect(db_path_for(args))) as conn, conn:
        apply_schema(conn)
        conn.row_factory = sqlite3.Row
        project = conn.execute(
            "SELECT * FROM projects WHERE project_id = ?", (args.project_id,)
        ).fetchone()
        if project is None:
            raise SystemExit(f"project not found: {args.project_id}")
        decisions = conn.execute(
            "SELECT * FROM project_decisions WHERE project_id = ?", (args.project_id,)
        ).fetchone()
        visible_state = conn.execute(
            "SELECT * FROM project_visible_state WHERE project_id = ?", (args.project_id,)
        ).fetchone()
        feedback_state = conn.execute(
            "SELECT * FROM project_feedback_state WHERE project_id = ?", (args.project_id,)
        ).fetchone()
        artist_library_files = conn.execute(
            """
            SELECT path, file_role, status, output_record_id, updated_at
            FROM artist_library_files
            WHERE project_id = ?
            ORDER BY updated_at, path
            """,
            (args.project_id,),
        ).fetchall()
        assets = conn.execute(
            """
            SELECT asset_id, asset_type, stage, status, path
            FROM assets
            WHERE project_id = ?
            ORDER BY created_at, asset_id
            """,
            (args.project_id,),
        ).fetchall()
        records = conn.execute(
            """
            SELECT record_type, path, status, updated_at
            FROM records
            WHERE project_id = ?
            ORDER BY record_type, path
            """,
            (args.project_id,),
        ).fetchall()
        output_artifacts = conn.execute(
            """
            SELECT output_record_id, artifact_id, artifact_kind, uri_or_path,
                   origin_type, provider, review_status, acceptance_status,
                   output_record_path
            FROM output_artifacts
            WHERE project_id = ?
            ORDER BY created_at, output_record_id
            """,
            (args.project_id,),
        ).fetchall()
    print(json.dumps({
        "project": dict(project),
        "decisions": dict(decisions) if decisions else None,
        "visible_state": dict(visible_state) if visible_state else None,
        "artist_library_files": [dict(file_ref) for file_ref in artist_library_files],
        "feedback_state": dict(feedback_state) if feedback_state else None,
        "records": [dict(record) for record in records],
        "output_artifacts": [dict(artifact) for artifact in output_artifacts],
        "assets": [dict(asset) for asset in assets],
    }, indent=2))


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    root.add_argument("--db", default=None)
    sub = root.add_subparsers(required=True)

    def add_library_args(command: argparse.ArgumentParser) -> None:
        command.add_argument("--library-root", default=None)
        command.add_argument("--wondermint-root", default=None)

    init = sub.add_parser("init", help="create or migrate the SQLite library database")
    add_library_args(init)
    init.set_defaults(func=init_db)

    setup = sub.add_parser("setup", help="create Workspace Library folders and initialize SQLite")
    add_library_args(setup)
    setup.set_defaults(func=setup_db)

    sync = sub.add_parser("sync", help="sync project manifests into the SQLite index")
    add_library_args(sync)
    sync.set_defaults(func=sync_db)

    feedback = sub.add_parser("add-feedback", help="append project feedback and mark learning review pending")
    feedback.add_argument("project_id")
    feedback.add_argument("--feedback", required=True)
    feedback.add_argument("--feedback-id", default=None)
    feedback.add_argument("--source", default="artist", choices=["artist", "agent_observation", "system"])
    feedback.add_argument("--stage", default=None)
    feedback.add_argument("--output-record-id", default=None)
    feedback.add_argument("--notes", default=None)
    add_library_args(feedback)
    feedback.set_defaults(func=add_feedback)

    learning = sub.add_parser("add-learning", help="write a compact learning record and link it to a project")
    learning.add_argument("project_id")
    learning.add_argument("learning_id")
    learning.add_argument("--learning-type", required=True, choices=["candidate", "soft", "hard"])
    learning.add_argument("--learning-rule", required=True)
    learning.add_argument("--scope", default=None)
    learning.add_argument("--evidence-type", default="feedback_entry", choices=LEARNING_EVIDENCE_TYPES)
    learning.add_argument("--evidence-ref", action="append", required=True)
    learning.add_argument("--evidence-summary", default=None)
    learning.add_argument("--occurrence-count", type=int, default=1)
    learning.add_argument("--promotion-reason", default=None)
    learning.add_argument("--mark-review-complete", action="store_true")
    learning.add_argument("--overwrite", action="store_true")
    add_library_args(learning)
    learning.set_defaults(func=add_learning)

    signal = sub.add_parser("add-performance-signal", help="write a performance signal and link it to a project")
    signal.add_argument("project_id")
    signal.add_argument("signal_id")
    signal.add_argument("--metric-name", required=True)
    signal.add_argument("--metric-value", required=True)
    signal.add_argument("--signal-direction", required=True, choices=["positive", "negative", "neutral", "mixed"])
    signal.add_argument("--source", default="manual_import")
    signal.add_argument("--output-record-id", default=None)
    signal.add_argument("--notes", default=None)
    signal.add_argument("--overwrite", action="store_true")
    add_library_args(signal)
    signal.set_defaults(func=add_performance_signal)

    review = sub.add_parser("mark-learning-review-complete", help="mark a project's learning review complete")
    review.add_argument("project_id")
    review.add_argument("--feedback-id", action="append")
    review.add_argument(
        "--classification-status",
        default="applied",
        choices=["candidate", "applied", "dismissed"],
    )
    add_library_args(review)
    review.set_defaults(func=mark_learning_review_complete)

    pending = sub.add_parser("pending-learning-reviews", help="list projects with pending learning review")
    add_library_args(pending)
    pending.set_defaults(func=pending_learning_reviews)

    report = sub.add_parser(
        "learnings-report",
        help="summarize per-project learning-review state, learnings, and signals (read-only)",
    )
    report.add_argument("project_id", nargs="?", default=None)
    add_library_args(report)
    report.set_defaults(func=learnings_report)

    link = sub.add_parser("link-visible-project", help="create a visible Artist Library project folder and Project Pointer")
    link.add_argument("project_id")
    link.add_argument("project_slug")
    link.add_argument("--title", default=None)
    link.add_argument("--summary", default=None)
    link.add_argument("--status", default=None)
    link.add_argument("--workspace-root-hint", default="../../../.wondermint/artist-os")
    link.add_argument("--library-root", default=None)
    link.add_argument("--wondermint-root", default=None)
    link.add_argument("--artist-library-root", default=None)
    link.add_argument("--overwrite-pointer", action="store_true")
    link.add_argument("--overwrite-readme", action="store_true")
    link.set_defaults(func=link_visible_project)

    publish = sub.add_parser("publish-visible-output", help="copy an Output Artifact into a visible Artist Library project folder")
    publish.add_argument("project_id")
    publish.add_argument("output_record_id")
    publish.add_argument("--state", default="draft", choices=sorted(VISIBLE_OUTPUT_STATE_TO_ROLE))
    publish.add_argument("--filename", default=None)
    publish.add_argument("--medium-folder", default=None)
    publish.add_argument("--library-root", default=None)
    publish.add_argument("--wondermint-root", default=None)
    publish.add_argument("--artist-library-root", default=None)
    publish.add_argument("--overwrite", action="store_true")
    publish.set_defaults(func=publish_visible_output)

    list_cmd = sub.add_parser("list", help="list indexed projects")
    add_library_args(list_cmd)
    list_cmd.set_defaults(func=list_projects)

    show = sub.add_parser("show", help="show one indexed project")
    show.add_argument("project_id")
    add_library_args(show)
    show.set_defaults(func=show_project)

    return root


def db_path_for(args: argparse.Namespace) -> Path:
    if getattr(args, "db", None):
        return Path(args.db)
    return library_root_for(args) / "artist-os.sqlite"


def main() -> None:
    args = parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
