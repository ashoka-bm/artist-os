#!/usr/bin/env bash
set -euo pipefail

skills_dir="${CODEX_SKILLS_DIR:-$HOME/.codex/skills}"
prefix="${ARTIST_OS_SKILL_PREFIX:-artist-os-}"

if [[ ! -d "$skills_dir" ]]; then
  echo "nothing to uninstall: $skills_dir does not exist"
  exit 0
fi

# Remove an installed Artist OS skill entry. Symlinks are removed directly;
# copied skill directories (created when install updated a real directory in
# place) are removed only after confirming the directory is the expected Artist
# OS skill, mirroring the safety checks in install-codex-dev-skills.
remove_skill() {
  local target="$1"
  local expected_name="$2"

  if [[ -L "$target" ]]; then
    rm "$target"
    echo "removed: $target"
    return
  fi

  if [[ -d "$target" ]]; then
    if [[ ! -f "$target/SKILL.md" ]]; then
      echo "refusing to remove non-skill directory: $target" >&2
      exit 1
    fi
    local target_name
    target_name="$(awk -F': ' '/^name: / {print $2; exit}' "$target/SKILL.md" | tr -d '"')"
    if [[ "$target_name" != "$expected_name" ]]; then
      echo "refusing to remove mismatched skill: $target has name '$target_name', expected '$expected_name'" >&2
      exit 1
    fi
    rm -rf "$target"
    echo "removed copied skill: $target"
    return
  fi

  echo "refusing to remove non-symlink file: $target" >&2
  exit 1
}

found=0

orchestrator="$skills_dir/artist-os"
if [[ -e "$orchestrator" ]]; then
  found=1
  remove_skill "$orchestrator" "artist-os"
fi

while IFS= read -r -d '' target; do
  found=1
  remove_skill "$target" "$(basename "$target")"
done < <(find "$skills_dir" -maxdepth 1 -name "$prefix*" -print0 | sort -z)

if [[ "$found" -eq 0 ]]; then
  echo "no Artist OS skills found in $skills_dir"
fi

cat <<'EOF'

The Workspace Library and artist-os.sqlite index are preserved. Remove them
manually if you also want to discard local project state.
EOF
