#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
version="$(cat "$repo_root/VERSION" 2>/dev/null || echo unknown)"
# Codex's install target and skill prefix come from the host registry (single
# source of truth), making bin/artist-os-paths (python3) a required install
# dependency — as the post-install doctor gate below also is.
codex_global_root="$("$repo_root/bin/artist-os-paths" get codex globalRoot)"
codex_prefix="$("$repo_root/bin/artist-os-paths" get codex skillPrefix)"
skills_dir="${CODEX_SKILLS_DIR:-$HOME/$codex_global_root}"
prefix="${ARTIST_OS_SKILL_PREFIX:-$codex_prefix}"
library_root="${ARTIST_OS_LIBRARY_ROOT:-$repo_root/workspace-library/artist-os}"
artist_library_root=""
setup_args=(setup)
if [[ -n "${ARTIST_OS_LIBRARY_ROOT:-}" ]]; then
  setup_args+=(--library-root "$library_root")
elif [[ -z "${WONDERMINT_ROOT:-}" ]]; then
  setup_args+=(--library-root "$library_root")
fi
if [[ -n "${WONDERMINT_ROOT:-}" ]]; then
  if [[ -z "${ARTIST_OS_LIBRARY_ROOT:-}" ]]; then
    library_root="$WONDERMINT_ROOT/.wondermint/artist-os"
  fi
  artist_library_root="$WONDERMINT_ROOT/Wondermint/Artist Library"
  setup_args+=(--wondermint-root "$WONDERMINT_ROOT")
fi

skills=(
  "ingest-reference"
  "meaning-interview"
  "text-to-image-plan"
  "video-journey"
  "text-to-suno-plan"
  "text-journey"
  "art-critic-review"
  "writing-method-review"
  "critique-asset"
  "clear-writing-pass"
  "human-voice-pass"
)

mkdir -p "$skills_dir"

install_skill() {
  local source_dir="$1"
  local target="$2"
  local skill_name
  skill_name="$(awk -F': ' '/^name: / {print $2; exit}' "$source_dir/SKILL.md" | tr -d '"')"

  if [[ ! -f "$source_dir/SKILL.md" ]]; then
    echo "missing skill source: $source_dir/SKILL.md" >&2
    exit 1
  fi

  if [[ -d "$target" && ! -L "$target" ]]; then
    if [[ ! -f "$target/SKILL.md" ]]; then
      echo "refusing to update non-skill directory: $target" >&2
      exit 1
    fi
    target_name="$(awk -F': ' '/^name: / {print $2; exit}' "$target/SKILL.md" | tr -d '"')"
    if [[ "$target_name" != "$skill_name" ]]; then
      echo "refusing to update mismatched skill: $target has name '$target_name', expected '$skill_name'" >&2
      exit 1
    fi
    cp "$source_dir/SKILL.md" "$target/SKILL.md"
    if [[ -d "$source_dir/references" ]]; then
      rm -rf "$target/references"
      cp -R "$source_dir/references" "$target/references"
    else
      rm -rf "$target/references"
    fi
    echo "updated copied skill: $target/SKILL.md"
    return
  fi

  if [[ -e "$target" && ! -L "$target" ]]; then
    echo "refusing to overwrite non-symlink file: $target" >&2
    exit 1
  fi

  if [[ -L "$target" ]]; then
    current_target="$(readlink "$target")"
    if [[ "$current_target" == "$source_dir" ]]; then
      echo "ok: $target -> $source_dir"
      return
    fi
    rm "$target"
    echo "updated: $target -> $source_dir"
  else
    echo "installed: $target -> $source_dir"
  fi

  ln -s "$source_dir" "$target"
}

install_skill "$repo_root/skills/artist-os" "$skills_dir/artist-os"

for skill in "${skills[@]}"; do
  source_dir="$repo_root/skills/$skill"
  target="$skills_dir/$prefix$skill"
  install_skill "$source_dir" "$target"
done

if ! doctor_out="$("$repo_root/bin/artist-os-paths" doctor 2>&1)"; then
  printf '%s\n' "$doctor_out" >&2
  echo "bundle verification failed (see doctor output above)" >&2
  exit 1
fi

"$repo_root/bin/artist-os-db" "${setup_args[@]}"

cat <<EOF

Artist OS v$version dev skills installed into:
  $skills_dir

Workspace Library initialized at:
  $library_root

$(if [[ -n "$artist_library_root" ]]; then printf 'Artist Library initialized at:\n  %s\n\n' "$artist_library_root"; fi)

Installed skill names:
  - artist-os
$(for skill in "${skills[@]}"; do printf '  - %s%s\n' "$prefix" "$skill"; done)

Existing copied Artist OS skill directories were updated in place; missing skills were installed as symlinks to this repo.
Codex may require a new thread or app reload to refresh skill discovery.
EOF
