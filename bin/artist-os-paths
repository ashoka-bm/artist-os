#!/usr/bin/env python3
"""Resolve the Artist OS bundle anchor ($ARTIST_OS_ROOT) and read the host registry.

Every Artist OS skill body names paths relative to the bundle root (THEORY.md,
docs/..., schemas/...). Those resolve from $ARTIST_OS_ROOT, which is the repo
root in a checkout and the installed bundle root on a host. This resolver
computes that anchor via a loud fallback chain and never falls back to the
current working directory, so a missing or misplaced bundle fails loudly
instead of silently reading the wrong files.

Output contract: `root` and `get` print a single RAW value on one line, meant to
be captured with command substitution (`r=$(artist-os-paths root)`). The output
is not shell-quoted, so do not `eval` it. `get` exits non-zero on an unknown
host or unknown key so a typo fails loud rather than yielding an empty value.

See docs/adr/0008-multi-host-skill-distribution.md.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

# A directory is a valid bundle root only if it carries all of these markers.
ROOT_MARKERS = ("THEORY.md", "schemas", "skills")
RESOLVER_BUNDLE_ROOT = Path(__file__).resolve().parents[1]
PACKAGING_DIR = "packaging"

# Backtick-quoted tokens in skill bodies that name canonical bundle content
# (the root docs plus the docs/ and schemas/ trees). `doctor` resolves these to
# fail loud on an orphaned reference. Workspace state (events.jsonl, project.json)
# and sibling-skill dirs are deliberately excluded.
_BACKTICK_RE = re.compile(r"`([^`]+)`")
_DOC_REF_RE = re.compile(r"^(?:THEORY|ARCHITECTURE|AGENTS|CONTEXT)\.md$|^docs/[^\s]+$|^schemas/[^\s]+$")


class ResolveError(Exception):
    pass


def _has_markers(path: Path) -> bool:
    return path.is_dir() and all((path / marker).exists() for marker in ROOT_MARKERS)


def _load_json(path: Path):
    if not path.exists():
        raise ResolveError(f"{path} not found")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ResolveError(f"{path} is not valid JSON: {exc}") from exc


def resolve_root() -> Path:
    """Return the bundle root via a loud fallback chain. Never returns cwd."""
    # 1. Explicit env override, sentinel-checked.
    env = os.environ.get("ARTIST_OS_ROOT")
    if env and env.strip():
        candidate = Path(env.strip())
        if not candidate.is_absolute():
            raise ResolveError(f"ARTIST_OS_ROOT must be an absolute path; got: {env!r}")
        if not _has_markers(candidate):
            raise ResolveError(
                f"ARTIST_OS_ROOT={candidate} is missing bundle markers "
                f"({', '.join(ROOT_MARKERS)}); it is not a valid Artist OS bundle root"
            )
        return candidate

    # 2. Resolver-relative bundle root (installed bundle or in-repo checkout).
    if _has_markers(RESOLVER_BUNDLE_ROOT):
        return RESOLVER_BUNDLE_ROOT

    # 3. Git toplevel. Only adds resolving power when the resolver lives deeper
    #    than <root>/bin in a checkout (so step 2's parent lacks the markers);
    #    in the canonical layout step 2 already caught it.
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(RESOLVER_BUNDLE_ROOT),
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        if top:
            candidate = Path(top)
            if _has_markers(candidate):
                return candidate
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass

    # 4. Loud failure. Never the current working directory.
    raise ResolveError(
        "could not resolve $ARTIST_OS_ROOT. Set ARTIST_OS_ROOT to the Artist OS "
        "bundle root (an absolute path containing " + ", ".join(ROOT_MARKERS) + "), "
        "or run this resolver from inside an installed bundle or checkout. "
        "Run `bin/artist-os-paths doctor` for details."
    )


def load_registry(root: Path) -> dict:
    return _load_json(root / PACKAGING_DIR / "hosts.json")


def load_manifest(root: Path) -> dict:
    return _load_json(root / PACKAGING_DIR / "MANIFEST.json")


def referenced_paths(root: Path) -> list[str]:
    """Bundle-content paths (root docs, docs/, schemas/) named in skill bodies."""
    refs: set[str] = set()
    for skill_md in sorted((root / "skills").glob("*/SKILL.md")):
        for token in _BACKTICK_RE.findall(skill_md.read_text(encoding="utf-8")):
            token = token.strip()
            if _DOC_REF_RE.match(token):
                refs.add(token)
    return sorted(refs)


def _format_scalar(value) -> str:
    # Render booleans as JSON literals (true/false) so bash callers can compare
    # against the JSON-convention value; strings raw; other scalars/containers as JSON.
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return value
    return json.dumps(value)


def cmd_root(args: list[str]) -> int:
    print(resolve_root())
    return 0


def cmd_get(args: list[str]) -> int:
    if len(args) < 2:
        print("usage: artist-os-paths get <host> <key>", file=sys.stderr)
        return 2
    host, key = args[0], args[1]
    hosts = load_registry(resolve_root()).get("hosts", {})
    if host not in hosts:
        print(f"unknown host {host!r}; known: {', '.join(hosts)}", file=sys.stderr)
        return 1
    cfg = hosts[host]
    if key not in cfg:
        print(f"unknown key {key!r} for host {host!r}; known: {', '.join(cfg)}", file=sys.stderr)
        return 3
    value = cfg[key]
    # Present-but-null -> empty output, success. Absent keys already failed above,
    # so an empty result here is an intentional null, never a typo.
    if value is not None:
        print(_format_scalar(value))
    return 0


def cmd_list_hosts(args: list[str]) -> int:
    registry = load_registry(resolve_root())
    primary = registry.get("primaryHost")
    for name, cfg in registry.get("hosts", {}).items():
        marker = " (primary)" if name == primary else ""
        print(f"{name}\t{cfg.get('status', 'unknown')}{marker}")
    return 0


def cmd_doctor(args: list[str]) -> int:
    try:
        root = resolve_root()
    except ResolveError as exc:
        print(f"FAIL  anchor: {exc}")
        return 1
    print(f"OK    $ARTIST_OS_ROOT = {root}")
    failed = False

    manifest = load_manifest(root)
    includes = manifest.get("include", [])
    for rel in includes:
        if (root / rel).exists():
            print(f"OK    manifest: {rel}")
        else:
            print(f"FAIL  manifest: {rel} (declared, not present under root)")
            failed = True

    refs = referenced_paths(root)
    missing = [r for r in refs if not (root / r).exists()]
    for r in missing:
        print(f"FAIL  reference: {r} (named in a skill body, not present under root)")
    print(f"{'FAIL' if missing else 'OK'}    references: {len(refs) - len(missing)}/{len(refs)} resolve")
    if missing:
        failed = True

    if failed:
        print("\nbundle INCOMPLETE — see FAIL lines above")
        return 1
    print(f"\nbundle complete: {len(includes)} manifest path(s) + {len(refs)} skill reference(s) reachable")
    return 0


def cmd_validate(args: list[str]) -> int:
    registry = load_registry(resolve_root())
    if not isinstance(registry, dict):
        print("FAIL  registry is not a JSON object", file=sys.stderr)
        return 1
    hosts = registry.get("hosts")
    if not isinstance(hosts, dict):
        print("FAIL  registry 'hosts' is missing or not an object", file=sys.stderr)
        return 1

    errors: list[str] = []
    primary = registry.get("primaryHost")
    if not primary:
        errors.append("registry missing 'primaryHost'")
    elif primary not in hosts:
        errors.append(f"primaryHost {primary!r} is not present in hosts")

    name_re = re.compile(r"^[a-z][a-z0-9-]*$")
    roots_seen: dict[str, str] = {}
    # The installer reads these from an active host (ADR 0008), so they must be present.
    active_required = {
        "skillPrefix": str,
        "globalRoot": str,
        "linkingStrategy": str,
        "conductorUnprefixed": bool,
        "usesEnvVars": bool,
        "pathRewrites": list,
        "frontmatter": dict,
    }
    stub_null = ("skillPrefix", "usesEnvVars", "linkingStrategy", "pathRewrites", "frontmatter", "conductorUnprefixed")

    for name, cfg in hosts.items():
        if not isinstance(cfg, dict):
            errors.append(f"host {name!r} config is not an object")
            continue
        if not name_re.match(name):
            errors.append(f"host name {name!r} fails ^[a-z][a-z0-9-]*$")
        status = cfg.get("status")
        if status not in ("active", "stub"):
            errors.append(f"host {name!r} has invalid status {status!r}")
        global_root = cfg.get("globalRoot")
        if global_root:
            if global_root in roots_seen:
                errors.append(
                    f"globalRoot {global_root!r} duplicated by {name!r} and {roots_seen[global_root]!r}"
                )
            roots_seen[global_root] = name
        if status == "active":
            for field, typ in active_required.items():
                val = cfg.get(field)
                if not isinstance(val, typ) or (typ is str and not val):
                    errors.append(f"active host {name!r} field {field!r} must be a non-empty {typ.__name__}")
        elif status == "stub":
            for field in stub_null:
                if cfg.get(field) is not None:
                    errors.append(f"stub host {name!r} must have null {field!r}")

    if errors:
        for err in errors:
            print(f"FAIL  {err}")
        return 1
    print(f"OK    registry valid: {len(hosts)} host(s), primary={primary}")
    return 0


COMMANDS = {
    "root": cmd_root,
    "get": cmd_get,
    "doctor": cmd_doctor,
    "list-hosts": cmd_list_hosts,
    "validate": cmd_validate,
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: artist-os-paths {root|get <host> <key>|doctor|list-hosts|validate}")
        return 0 if argv else 2
    cmd = argv[0]
    if cmd not in COMMANDS:
        print(f"unknown command {cmd!r}; use one of {', '.join(COMMANDS)}", file=sys.stderr)
        return 2
    try:
        return COMMANDS[cmd](argv[1:])
    except ResolveError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
