#!/usr/bin/env python3
"""Validate Artist OS example and fixture JSON records against repo schemas."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))

from artist_os_schema_validator import ValidationError, iter_validation_targets, validate_file


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    root.add_argument(
        "--examples-only",
        action="store_true",
        help="validate examples/ only, skipping tests/fixtures",
    )
    return root


def main() -> int:
    args = parser().parse_args()
    targets = iter_validation_targets(include_fixtures=not args.examples_only)
    failures = []
    for schema_path, data_path in targets:
        try:
            validate_file(schema_path, data_path)
        except (ValidationError, ValueError, KeyError) as exc:
            failures.append((schema_path, data_path, exc))
            print(f"FAIL {data_path.relative_to(REPO_ROOT)} -> {schema_path.name}: {exc}")
        else:
            print(f"OK   {data_path.relative_to(REPO_ROOT)} -> {schema_path.name}")
    if failures:
        print(f"\n{len(failures)} validation failure(s)")
        return 1
    print(f"\nvalidated {len(targets)} record(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
