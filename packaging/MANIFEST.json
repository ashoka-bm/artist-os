{
  "description": "The reference surface that must travel with an installed Artist OS skill bundle so skill-body paths (THEORY.md, docs/..., schemas/...) resolve from $ARTIST_OS_ROOT. Paths are bundle-root-relative; a trailing slash denotes a directory tree. See docs/adr/0008-multi-host-skill-distribution.md.",
  "include": [
    "THEORY.md",
    "theory/",
    "ARCHITECTURE.md",
    "AGENTS.md",
    "CONTEXT.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "VERSION",
    "artist_os_adapter_guards.py",
    "artist_os_schema_validator.py",
    "bin/artist-os-db",
    "bin/artist-os-import-output",
    "bin/artist-os-paths",
    "bin/artist-os-video-finalize",
    "bin/install-codex-skills",
    "bin/uninstall-codex-skills",
    "docs/",
    "schemas/",
    "skills/",
    "packaging/"
  ],
  "exclude": [
    "workspace-library/",
    "artist-os-library/",
    ".tmp/",
    "*.sqlite",
    ".env",
    ".git/",
    "__pycache__/",
    "packaging/build/"
  ]
}
