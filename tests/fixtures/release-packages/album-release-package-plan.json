  "album_sonic_system": {
    "status": "artist_approved_for_calibration",
    "shared_sonic_language": "Suspended builds, restrained low pulses, and unresolved harmonic openings carry the album's threshold pressure.",
    "allowed_variation": [
      "Each track may change density and vocal presence as long as release remains withheld.",
      "The final track may thin out instead of climaxing."
    ],
    "recurring_motifs": [
      "a key-like metallic attack",
      "doorway reverb that opens but never resolves"
    ],
    "voice_and_instrumentation": [
      "close, restrained vocal fragments when lyrics are used",
      "muted piano, low synth, brushed percussion"
    ],
    "production_constraints": [
      "avoid triumphant drops",
      "avoid bright major-key release"
    ],
    "consistency_rules": [
      "Every track should keep one sound element suspended past its expected resolution."
    ]
  },
  "album_visual_system": {
    "status": "artist_approved_for_calibration",
    "shared_visual_language": "Doorway light, hand-scale objects, and negative space make each cover feel close to action but not released.",
    "allowed_variation": [
      "Track Covers may change object focus and distance from the threshold.",
      "The album cover may be more iconic than the Track Covers."
    ],
    "recurring_symbols": [
      "key",
      "lit threshold",
      "uncrossed boundary"
    ],
    "style_constraints": [
      "restrained cinematic realism",
      "low contrast around the figure with precise light at the threshold"
    ],
    "consistency_rules": [
      "No cover should show the figure fully crossing the doorway."
    ]
  },
