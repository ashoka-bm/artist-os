{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/beat-plan.schema.json",
  "title": "BeatPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "beat_plan_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "story_mode",
    "story_gate_status",
    "workflow_scale_routing",
    "beats",
    "tension_points",
    "key_emotional_movements",
    "tension_movement_plan",
    "arc_summary",
    "story_critic_review",
    "story_approval",
    "traceability_summary"
  ],
  "properties": {
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "story_mode": { "$ref": "#/$defs/story_mode" },
    "story_gate_status": { "$ref": "#/$defs/approval_status" },
    "story_structure": { "$ref": "#/$defs/story_structure" },
    "workflow_scale_routing": { "$ref": "#/$defs/workflow_scale_routing" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/beat_record" }
    },
    "tension_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/tension_point_record" }
    },
    "key_emotional_movements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/key_emotional_movement" }
    },
    "tension_movement_plan": { "$ref": "#/$defs/tension_movement_plan" },
    "arc_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beginning", "turn", "ending_or_residue", "scale_rationale"],
      "properties": {
        "beginning": { "type": "string" },
        "turn": { "type": "string" },
        "ending_or_residue": { "type": "string" },
        "scale_rationale": { "type": "string" }
      }
    },
    "story_critic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "review_record_id", "approval_status"],
      "properties": {
        "required": { "type": "boolean" },
        "review_record_id": { "type": ["string", "null"], "pattern": "^review_[a-zA-Z0-9_-]+$" },
        "approval_status": { "$ref": "#/$defs/review_approval_status" }
      }
    },
    "story_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approved_at", "waived_blocks"],
      "properties": {
        "status": { "$ref": "#/$defs/approval_status" },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "waived_blocks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["story_mode"],
        "properties": {
          "story_mode": {
            "enum": ["beat_pair", "three_part_sequence", "sequence", "scene", "arc", "world"]
          }
        }
      },
      "then": {
        "required": ["story_structure"]
      }
    }
  ],
  "$defs": {
    "story_mode": {
      "type": "string",
      "enum": ["single_beat", "beat_pair", "three_part_sequence", "sequence", "scene", "arc", "world"]
    },
    "approval_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "approved", "unconfirmed", "waived", "rejected"]
    },
    "review_approval_status": {
      "type": "string",
      "enum": ["not_required", "pending", "approve", "revise", "block", "waived"]
    },
    "workflow_scale_level": {
      "type": "string",
      "enum": ["compact_artifact", "structured_single_artifact", "cumulative_work", "full_long_form_project"]
    },
    "workflow_scale_support": {
      "type": "string",
      "enum": [
        "core_pipeline",
        "medium_section_plan",
        "cultural_format_structure",
        "long_work_stewardship",
        "long_work_parts",
        "long_work_readiness",
        "long_work_checkpoints",
        "stewardship_views",
        "plot_tracker",
        "character_sheets",
        "world_building",
        "chapter_or_scene_briefs",
        "style_guide",
        "extraction_verification",
        "synthesis_checkpoints",
        "publishing_or_completion_audit",
        "collection_coherence_review"
      ]
    },
    "workflow_scale_trigger_signal": {
      "type": "string",
      "enum": [
        "artist_requested_compact_output",
        "artist_requested_long_form",
        "artist_requested_sequence_or_series",
        "single_artifact_can_hold_movement",
        "internal_sections_or_movements_needed",
        "dependent_parts_needed",
        "durable_canon_needed",
        "recurring_characters_needed",
        "world_rules_or_timeline_needed",
        "subplots_or_open_threads_needed",
        "voice_or_style_continuity_needed",
        "extraction_verification_needed",
        "synthesis_or_batch_generation_needed",
        "publication_or_completion_audit_needed",
        "collection_without_sequence"
      ]
    },
    "workflow_scale_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_level", "rationale", "trigger_signals", "activated_supports", "skipped_supports", "reroute_triggers"],
      "properties": {
        "scale_level": { "$ref": "#/$defs/workflow_scale_level" },
        "rationale": { "type": "string", "minLength": 1 },
        "trigger_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_trigger_signal" }
        },
        "activated_supports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "skipped_supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "reroute_triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "story_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_entry_id",
        "name",
        "grounding_status",
        "grounding_tier",
        "core_movement",
        "adaptation_summary",
        "turn_logic",
        "compression_rule",
        "expansion_rule",
        "failure_modes"
      ],
      "properties": {
        "library_entry_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "grounding_status": { "type": "string", "enum": ["provisional", "researched", "artist_defined", "project_specific"] },
        "grounding_tier": {
          "type": "string",
          "enum": ["canonical_framework", "craft_authority", "platform_pattern_evidence", "artist_defined_project_specific"]
        },
        "core_movement": { "type": "string", "minLength": 1 },
        "adaptation_summary": { "type": "string", "minLength": 1 },
        "turn_logic": { "type": "string", "minLength": 1 },
        "compression_rule": { "type": "string", "minLength": 1 },
        "expansion_rule": { "type": "string", "minLength": 1 },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "beat_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "beat_role",
        "one_move_summary",
        "before_state",
        "after_state",
        "value_shift",
        "expectation_turn",
        "intended_feeling",
        "emotional_payload",
        "tension_profile",
        "source_evidence",
        "must_preserve",
        "pivot_options",
        "traceability_notes"
      ],
      "properties": {
        "beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "beat_role": {
          "type": "string",
          "enum": [
            "invitation",
            "grounding",
            "encounter",
            "threshold",
            "build",
            "rupture",
            "reveal",
            "concealment",
            "reversal",
            "surrender",
            "transformation",
            "consequence",
            "return",
            "closure",
            "residue",
            "unresolved_echo"
          ]
        },
        "one_move_summary": { "type": "string" },
        "builds_toward_key_movement_id": { "type": ["string", "null"], "pattern": "^kem_[a-zA-Z0-9_-]+$" },
        "before_state": { "type": "string" },
        "after_state": { "type": "string" },
        "value_shift": { "type": "string" },
        "expectation_turn": { "$ref": "#/$defs/expectation_turn" },
        "intended_feeling": { "type": "string", "minLength": 1 },
        "emotional_payload": { "type": "string", "minLength": 1 },
        "tension_profile": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tension_profile_entry" }
        },
        "source_evidence": { "type": "array", "items": { "type": "string" } },
        "must_preserve": { "type": "array", "items": { "type": "string" } },
        "pivot_options": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "next_move", "rationale"],
            "properties": {
              "label": { "type": "string" },
              "next_move": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "medium_translation_notes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string" },
            "video": { "type": "string" },
            "sound": { "type": "string" },
            "text": { "type": "string" },
            "mixed_media": { "type": "string" }
          }
        },
        "traceability_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        }
      }
    },
    "tension_point_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tension_point_id", "summary", "intended_feeling", "emotional_payload", "source_evidence", "traceability_notes"],
      "properties": {
        "tension_point_id": { "type": "string", "pattern": "^tp_[a-zA-Z0-9_-]+$" },
        "summary": { "type": "string" },
        "intended_feeling": { "type": "string", "minLength": 1 },
        "emotional_payload": { "type": "string", "minLength": 1 },
        "source_evidence": { "type": "array", "items": { "type": "string" } },
        "traceability_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        }
      }
    },
    "tension_movement_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_goal",
        "minimum_tension_criteria",
        "adjacent_beat_shifts",
        "reviewer_instruction"
      ],
      "properties": {
        "contrast_goal": { "type": "string", "minLength": 1 },
        "minimum_tension_criteria": { "$ref": "#/$defs/minimum_tension_criteria" },
        "adjacent_beat_shifts": {
          "type": "array",
          "items": { "$ref": "#/$defs/adjacent_beat_shift" }
        },
        "reviewer_instruction": { "type": "string", "minLength": 1 }
      }
    },
    "key_emotional_movement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_id",
        "role",
        "beat_ids",
        "emotional_shift",
        "compression_priority",
        "traceability_notes"
      ],
      "properties": {
        "movement_id": { "type": "string", "pattern": "^kem_[a-zA-Z0-9_-]+$" },
        "role": {
          "type": "string",
          "enum": [
            "opening_pressure",
            "inciting_shift",
            "threshold",
            "midpoint_turn",
            "rupture",
            "revelation",
            "penultimate_climax",
            "climax",
            "aftermath",
            "residue",
            "unresolved_echo"
          ]
        },
        "beat_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" }
        },
        "emotional_shift": { "type": "string", "minLength": 1 },
        "compression_priority": {
          "type": "string",
          "enum": ["primary", "secondary", "supporting"]
        },
        "traceability_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        }
      }
    },
    "expectation_turn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_direction",
        "actual_result",
        "surprise_function",
        "emotional_counterpoint"
      ],
      "properties": {
        "expected_direction": { "type": "string", "minLength": 1 },
        "actual_result": { "type": "string", "minLength": 1 },
        "surprise_function": { "type": "string", "minLength": 1 },
        "emotional_counterpoint": { "type": "string", "minLength": 1 }
      }
    },
    "minimum_tension_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_active_tensions",
        "minimum_primary_tension_intensity",
        "minimum_adjacent_shift_count",
        "minimum_adjacent_shift_delta",
        "waiver_rule"
      ],
      "properties": {
        "minimum_active_tensions": { "type": "integer", "minimum": 1 },
        "minimum_primary_tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_adjacent_shift_count": { "type": "integer", "minimum": 0 },
        "minimum_adjacent_shift_delta": { "type": "number", "minimum": 0, "maximum": 1 },
        "waiver_rule": { "type": "string", "minLength": 1 }
      }
    },
    "adjacent_beat_shift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_beat_id",
        "to_beat_id",
        "shift_summary",
        "shifted_tensions",
        "meets_minimum"
      ],
      "properties": {
        "from_beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "to_beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "shift_summary": { "type": "string", "minLength": 1 },
        "shifted_tensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/tension_shift_entry" }
        },
        "meets_minimum": { "type": "boolean" }
      }
    },
    "tension_shift_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from_intensity", "to_intensity", "delta", "direction"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "to_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta": { "type": "number", "minimum": 0, "maximum": 1 },
        "direction": { "type": "string", "enum": ["increases", "decreases", "holds", "inverts"] }
      }
    },
    "tension_profile_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tension_intensity", "emotional_function"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "emotional_function": { "type": "string", "minLength": 1 }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["reference_evidence", "artist_meaning", "transformation_brief", "core_tension_pair", "poetic_density_note", "prior_beat", "story_gate"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
