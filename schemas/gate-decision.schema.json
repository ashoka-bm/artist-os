{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/gate-decision.schema.json",
  "title": "GateDecision",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "description": "A Cross-Medium Plan Approval must point at the plan it approves and at the Mixed-Media Critic Review that preceded it.",
      "if": {
        "required": ["gate_type"],
        "properties": { "gate_type": { "const": "cross_medium_plan_approval" } }
      },
      "then": {
        "properties": {
          "upstream_refs": {
            "allOf": [
              {
                "contains": {
                  "required": ["ref_type"],
                  "properties": { "ref_type": { "const": "cross_medium_plan" } }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "required": ["ref_type"],
                  "properties": { "ref_type": { "const": "review_record" } }
                },
                "minContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["gate_type"],
        "properties": { "gate_type": { "const": "package_format_selection_and_completeness" } }
      },
      "then": { "required": ["package_completeness"] }
    },
    {
      "description": "The completeness block belongs only to its own gate.",
      "if": { "required": ["package_completeness"] },
      "then": {
        "properties": {
          "gate_type": { "const": "package_format_selection_and_completeness" }
        }
      }
    }
  ],
  "required": [
    "gate_decision_id",
    "project_id",
    "source_id",
    "artist_meaning_id",
    "gate_type",
    "gate_status",
    "decision",
    "options_presented",
    "selected_option",
    "artist_response",
    "proceed_unconfirmed",
    "upstream_refs",
    "created_at"
  ],
  "properties": {
    "gate_decision_id": { "type": "string", "pattern": "^gate_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "gate_type": {
      "type": "string",
      "enum": [
        "routing",
        "character_reference_strategy",
        "visual_reference_sheet_strategy",
        "meaning_confirmation",
        "research_grounding",
        "interpretation",
        "story",
        "story_approval",
        "symbology",
        "presentation_mode",
        "style",
        "detail_intensity",
        "video_format",
        "scene_sequence",
        "shot_logic",
        "motion_pacing_transition",
        "audio_posture",
        "sound_work_type",
        "sonic_concept",
        "genre_production",
        "tempo_groove",
        "vocal_lyric",
        "arrangement_form",
        "writing_method",
        "format_length",
        "text_form",
        "voice_pov",
        "structure",
        "fidelity_transformation",
        "publication_use",
        "review_presentation",
        "brief_approval",
        "illustration_plan_approval",
        "prompt_branch",
        "prompt_lock",
        "long_work_stewardship_activation",
        "long_work_checkpoint",
        "release_package_plan_approval",
        "cross_medium_plan_approval",
        "package_format_selection_and_completeness",
        "album_calibration",
        "generation_approval",
        "draft_generation_approval",
        "output_acceptance"
      ]
    },
    "gate_status": {
      "type": "string",
      "enum": ["not_started", "proposed", "selected", "revised", "skipped", "unconfirmed", "approved", "blocked"]
    },
    "decision": { "type": "string", "minLength": 1 },
    "options_presented": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "label", "summary"],
        "properties": {
          "option_id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "selected_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label"],
      "properties": {
        "option_id": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "artist_response": { "type": "string" },
    "proceed_unconfirmed": { "type": "boolean" },
    "upstream_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_type", "ref_id", "path_or_ref"],
        "properties": {
          "ref_type": {
            "type": "string",
                "enum": ["source_record", "artist_meaning", "transformation_brief", "beat_plan", "long_work_stewardship", "release_package_plan", "cross_medium_plan", "asset_package", "medium_plan", "character_template", "visual_reference_sheet_plan", "illustration_plan", "creative_brief", "prompt_plan", "prompt_branch_set", "output_record", "review_record"]
          },
          "ref_id": { "type": "string" },
          "path_or_ref": { "type": "string" }
        }
      }
    },
    "package_completeness": {
      "type": "object",
      "description": "Package Format Selection And Completeness Gate payload. One Gate Decision per waived required slot: a waiver names exactly one slot, so a general 'ship anyway' decision cannot waive unnamed deliverables.",
      "additionalProperties": false,
      "required": ["package_format_id", "completeness_verdict"],
      "properties": {
        "package_format_id": {
          "type": "string",
          "enum": ["album", "article_with_photos", "video_with_soundtrack"]
        },
        "completeness_verdict": {
          "type": "string",
          "enum": [
            "format_selected",
            "all_required_slots_filled",
            "required_slot_waived",
            "returned_to_medium_journey"
          ]
        },
        "waived_slot_id": {
          "type": "string",
          "minLength": 1,
          "description": "The single Package Format slot this decision waives. Present only for the required_slot_waived verdict; the Asset Package carries this gate's id in that slot's waiver_gate_id."
        },
        "asset_package_id": { "type": ["string", "null"], "pattern": "^assetpkg_[a-zA-Z0-9_-]+$" }
      },
      "allOf": [
        {
          "if": {
            "required": ["completeness_verdict"],
            "properties": { "completeness_verdict": { "const": "required_slot_waived" } }
          },
          "then": { "required": ["waived_slot_id"] }
        },
        {
          "description": "Naming a waived slot is only meaningful for a waiver verdict.",
          "if": { "required": ["waived_slot_id"] },
          "then": {
            "properties": { "completeness_verdict": { "const": "required_slot_waived" } }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
