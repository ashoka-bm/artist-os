{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/text-medium-plan.schema.json",
  "title": "TextMediumPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text_medium_plan_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "target_media_type",
    "story_mode",
    "workflow_scale_routing",
    "writing_method",
    "text_form",
    "voice_point_of_view",
    "structure_plan",
    "length_policy",
    "fidelity_policy",
    "publication_use",
    "gates",
    "review_requirements",
    "traceability_summary"
  ],
  "properties": {
    "text_medium_plan_id": { "type": "string", "pattern": "^tmp_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "target_media_type": { "type": "string", "const": "text" },
    "story_mode": { "$ref": "#/$defs/story_mode" },
    "workflow_scale_routing": { "$ref": "#/$defs/workflow_scale_routing" },
    "character_reference_strategy": { "$ref": "#/$defs/character_reference_strategy" },
    "writing_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_method", "method_modifiers", "rationale"],
      "properties": {
        "primary_method": { "type": "string", "enum": ["fragments", "beats", "shape", "hybrid"] },
        "method_modifiers": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "medium_output_shape_recommendation": { "$ref": "#/$defs/medium_output_shape_recommendation" },
    "cultural_format_structure": { "$ref": "#/$defs/cultural_format_structure" },
    "text_form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_text_form", "text_form_modifiers", "confirmation_status", "rationale", "avoid"],
      "properties": {
        "primary_text_form": { "$ref": "#/$defs/text_form" },
        "text_form_modifiers": { "type": "array", "items": { "$ref": "#/$defs/text_form" } },
        "confirmation_status": { "type": "string", "enum": ["artist_specified", "confirmed", "unconfirmed"] },
        "rationale": { "type": "string", "minLength": 1 },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "voice_point_of_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speaker", "point_of_view", "distance", "register", "authority", "voice_constraints"],
      "properties": {
        "speaker": { "type": "string", "minLength": 1 },
        "point_of_view": { "type": "string", "minLength": 1 },
        "distance": { "type": "string", "minLength": 1 },
        "register": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "voice_constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "structure_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure_type", "structure_rationale", "sections"],
      "properties": {
        "structure_type": { "type": "string", "enum": ["fragment", "scene", "sequence", "arc", "acts", "sections", "verses", "argument", "hybrid"] },
        "structure_rationale": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text_section_plan" }
        }
      }
    },
    "length_policy": { "$ref": "#/$defs/length_policy" },
    "fidelity_policy": { "$ref": "#/$defs/fidelity_policy" },
    "publication_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_case", "audience", "privacy_notes", "rights_notes"],
      "properties": {
        "use_case": { "type": "string", "enum": ["private_draft", "performance_text", "lyrics", "social_post", "book_fragment", "prompt_source", "artist_statement", "other"] },
        "audience": { "type": "string" },
        "privacy_notes": { "type": "string" },
        "rights_notes": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writing_method_gate", "text_form_gate", "voice_point_of_view_gate", "structure_gate", "fidelity_transformation_gate", "publication_use_gate"],
      "properties": {
        "writing_method_gate": { "$ref": "#/$defs/gate_status" },
        "text_form_gate": { "$ref": "#/$defs/gate_status" },
        "voice_point_of_view_gate": { "$ref": "#/$defs/gate_status" },
        "structure_gate": { "$ref": "#/$defs/gate_status" },
        "fidelity_transformation_gate": { "$ref": "#/$defs/gate_status" },
        "publication_use_gate": { "$ref": "#/$defs/gate_status" }
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_reviewer_required", "writing_critic_required", "prompt_critic_required", "output_critic_required"],
      "properties": {
        "beat_reviewer_required": { "type": "boolean" },
        "writing_critic_required": { "type": "boolean", "const": true },
        "prompt_critic_required": { "type": "boolean", "const": true },
        "output_critic_required": { "type": "boolean", "const": true }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    }
  },
  "$defs": {
    "story_mode": {
      "type": "string",
      "enum": ["single_beat", "beat_pair", "three_part_sequence", "sequence", "scene", "arc", "world"]
    },
    "gate_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "complete", "skipped", "unconfirmed"]
    },
    "text_form": {
      "type": "string",
      "enum": ["poem", "prose_scene", "short_story", "article", "monologue", "script", "lyrics", "letter", "essay_artist_statement", "manifesto", "treatment_outline", "rewrite_adaptation", "other"]
    },
    "workflow_scale_level": {
      "type": "string",
      "enum": ["compact_artifact", "structured_single_artifact", "cumulative_work", "full_long_form_project"]
    },
    "workflow_scale_support": {
      "type": "string",
      "enum": [
        "core_pipeline",
        "medium_section_plan",
        "cultural_format_structure",
        "long_work_stewardship",
        "long_work_parts",
        "long_work_readiness",
        "long_work_checkpoints",
        "stewardship_views",
        "plot_tracker",
        "character_sheets",
        "world_building",
        "chapter_or_scene_briefs",
        "style_guide",
        "extraction_verification",
        "synthesis_checkpoints",
        "publishing_or_completion_audit",
        "collection_coherence_review"
      ]
    },
    "workflow_scale_trigger_signal": {
      "type": "string",
      "enum": [
        "artist_requested_compact_output",
        "artist_requested_long_form",
        "artist_requested_sequence_or_series",
        "single_artifact_can_hold_movement",
        "internal_sections_or_movements_needed",
        "dependent_parts_needed",
        "durable_canon_needed",
        "recurring_characters_needed",
        "world_rules_or_timeline_needed",
        "subplots_or_open_threads_needed",
        "voice_or_style_continuity_needed",
        "extraction_verification_needed",
        "synthesis_or_batch_generation_needed",
        "publication_or_completion_audit_needed",
        "collection_without_sequence"
      ]
    },
    "workflow_scale_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_level", "rationale", "trigger_signals", "activated_supports", "skipped_supports", "reroute_triggers"],
      "properties": {
        "scale_level": { "$ref": "#/$defs/workflow_scale_level" },
        "rationale": { "type": "string", "minLength": 1 },
        "trigger_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_trigger_signal" }
        },
        "activated_supports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "skipped_supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "reroute_triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strategy_status": {
      "type": "string",
      "enum": ["accepted", "declined", "deferred", "not_applicable"]
    },
    "character_reference_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_ref", "character_template_refs", "visual_reference_sheet_plan_refs", "notes"],
      "properties": {
        "status": { "$ref": "#/$defs/strategy_status" },
        "decision_ref": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" },
        "character_template_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^char_[a-zA-Z0-9_-]+$" }
        },
        "visual_reference_sheet_plan_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^vrs_[a-zA-Z0-9_-]+$" }
        },
        "notes": { "type": "string" }
      }
    },
    "medium_output_shape_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_shape",
        "recommended_shape",
        "accepted_shape",
        "rationale",
        "alternatives_considered",
        "tradeoffs",
        "conflict"
      ],
      "properties": {
        "requested_shape": { "type": ["string", "null"], "minLength": 1 },
        "recommended_shape": { "type": "string", "minLength": 1 },
        "accepted_shape": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "alternatives_considered": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tradeoffs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflict": { "$ref": "#/$defs/medium_output_shape_conflict" }
      }
    },
    "medium_output_shape_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_conflict", "conflict_summary", "resolution", "gate_decision_id"],
      "properties": {
        "has_conflict": { "type": "boolean" },
        "conflict_summary": { "type": ["string", "null"], "minLength": 1 },
        "resolution": {
          "type": "string",
          "enum": ["not_needed", "accepted_recommendation", "kept_requested_shape", "revised_shape", "proceeded_unconfirmed", "waived"]
        },
        "gate_decision_id": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" }
      }
    },
    "cultural_format_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_entry_id",
        "name",
        "grounding_status",
        "grounding_tier",
        "audience_promise",
        "audience_hook",
        "parts",
        "turn_or_payoff",
        "adaptation_policy",
        "failure_modes",
        "recommended_stewardship_views"
      ],
      "properties": {
        "library_entry_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "grounding_status": { "type": "string", "enum": ["provisional", "researched", "artist_defined", "project_specific"] },
        "grounding_tier": {
          "type": "string",
          "enum": ["canonical_framework", "craft_authority", "platform_pattern_evidence", "artist_defined_project_specific"]
        },
        "audience_promise": { "type": "string", "minLength": 1 },
        "audience_hook": { "type": "string", "minLength": 1 },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cultural_format_part" }
        },
        "turn_or_payoff": { "type": "string", "minLength": 1 },
        "adaptation_policy": { "$ref": "#/$defs/cultural_format_adaptation_policy" },
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended_stewardship_views": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cultural_format_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "label", "function", "maps_to_section_ids"],
      "properties": {
        "part_id": { "type": "string", "pattern": "^cfs_part_[a-zA-Z0-9_-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "maps_to_section_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^txtsec_[a-zA-Z0-9_-]+$" }
        }
      }
    },
    "cultural_format_adaptation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "mergeable", "omittable", "invertible"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "mergeable": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "omittable": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "invertible": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "length_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard_source",
        "target_word_count",
        "minimum_word_count",
        "maximum_word_count",
        "flexibility",
        "rationale",
        "artist_override"
      ],
      "properties": {
        "standard_source": { "type": "string", "minLength": 1 },
        "target_word_count": { "type": "integer", "minimum": 1 },
        "minimum_word_count": { "type": "integer", "minimum": 1 },
        "maximum_word_count": { "type": "integer", "minimum": 1 },
        "flexibility": { "type": "string", "enum": ["tight", "standard", "loose", "artist_defined"] },
        "rationale": { "type": "string", "minLength": 1 },
        "artist_override": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["override_word_count", "override_reason", "gate_decision_id"],
          "properties": {
            "override_word_count": { "type": ["integer", "null"], "minimum": 1 },
            "override_reason": { "type": "string", "minLength": 1 },
            "gate_decision_id": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" }
          }
        }
      }
    },
    "fidelity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_wording_constraints", "transformation_allowed", "rights_notes", "rationale"],
      "properties": {
        "mode": { "type": "string", "enum": ["preserve_source_wording", "adapt_source_wording", "invert", "expand", "compress", "translate", "new_from_meaning"] },
        "source_wording_constraints": { "type": "array", "items": { "type": "string" } },
        "transformation_allowed": { "type": "array", "items": { "type": "string" } },
        "rights_notes": { "type": "string" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "text_section_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "beat_id",
        "key_emotional_movement_id",
        "section_label",
        "structure_role",
        "section_job",
        "intended_feeling",
        "expectation_turn_translation",
        "source_wording_notes",
        "paragraph_distinction"
      ],
      "properties": {
        "section_id": { "type": "string", "pattern": "^txtsec_[a-zA-Z0-9_-]+$" },
        "beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "key_emotional_movement_id": { "type": "string", "pattern": "^kem_[a-zA-Z0-9_-]+$" },
        "section_label": { "type": "string" },
        "structure_role": { "type": "string" },
        "section_job": { "type": "string", "minLength": 1 },
        "intended_feeling": { "type": "string", "minLength": 1 },
        "expectation_turn_translation": { "type": "string", "minLength": 1 },
        "source_wording_notes": { "type": "array", "items": { "type": "string" } },
        "paragraph_distinction": { "type": "string", "minLength": 1 }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "reference_evidence", "transformation_brief", "beat_plan", "beat", "tension_point", "gate_decision"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
