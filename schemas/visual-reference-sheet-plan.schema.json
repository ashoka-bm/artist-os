{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/visual-reference-sheet-plan.schema.json",
  "title": "VisualReferenceSheetPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "visual_reference_sheet_plan_id",
    "project_id",
    "source_id",
    "artist_meaning_id",
    "reference_sheet_type",
    "subject_ref",
    "subject_description",
    "style_direction_summary",
    "view_layout",
    "reference_outputs",
    "prompt_text",
    "generation_policy",
    "output_record_refs",
    "traceability_summary",
    "created_at"
  ],
  "properties": {
    "visual_reference_sheet_plan_id": { "type": "string", "pattern": "^vrs_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": ["string", "null"], "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": ["string", "null"], "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "reference_sheet_type": {
      "type": "string",
      "description": "Visual layout target for the sheet. A promoted Reference Inventory location subject (subject_category \"location\") is planned as reference_sheet_type \"setting\"; the continuity-subject taxonomy and this layout vocabulary use different words for the same subject family.",
      "enum": ["character", "product", "object", "setting", "style"]
    },
    "subject_ref": { "$ref": "#/$defs/ref_or_null" },
    "subject_description": { "type": "string", "minLength": 1 },
    "style_direction_summary": { "type": "string", "minLength": 1 },
    "view_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type", "background", "views"],
      "properties": {
        "layout_type": {
          "type": "string",
          "enum": [
            "four_view_reference_sheet",
            "multi_image_reference_package",
            "three_angle_reference_package",
            "multi_section_reference_sheet"
          ]
        },
        "background": { "type": "string", "minLength": 1 },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["view_id", "label", "description"],
            "properties": {
              "view_id": { "type": "string", "pattern": "^view_[a-zA-Z0-9_-]+$" },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reference_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_output_id",
          "output_role",
          "image_count",
          "prompt_text",
          "layout_notes",
          "downstream_use"
        ],
        "properties": {
          "reference_output_id": { "type": "string", "pattern": "^refout_[a-zA-Z0-9_-]+$" },
          "output_role": {
            "type": "string",
            "enum": [
              "character_identity_plate",
              "character_turnaround_sheet",
              "character_macro_detail_card",
              "character_expression_sheet",
              "character_pose_action_sheet",
              "character_wardrobe_sheet",
              "character_style_variant_sheet",
              "location_establishing_angle",
              "location_reverse_angle",
              "location_functional_angle",
              "object_multi_angle_sheet",
              "style_calibration_sheet",
              "custom"
            ]
          },
          "image_count": { "type": "integer", "minimum": 1 },
          "prompt_text": { "type": "string", "minLength": 1 },
          "layout_notes": { "type": "string", "minLength": 1 },
          "downstream_use": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "prompt_text": { "type": "string", "minLength": 1 },
    "generation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_drafting_allowed", "generation_requires_approval", "approval_gate_id", "notes"],
      "properties": {
        "prompt_drafting_allowed": { "type": "boolean", "const": true },
        "generation_requires_approval": { "type": "boolean", "const": true },
        "approval_gate_id": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" },
        "notes": { "type": "string" }
      }
    },
    "output_record_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^out_[a-zA-Z0-9_-]+$" }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ref_or_null": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref_type", "ref_id", "path_or_ref"],
          "properties": {
            "ref_type": {
              "type": "string",
              "enum": ["character_template", "source_record", "output_record", "asset_metadata"]
            },
            "ref_id": { "type": "string" },
            "path_or_ref": { "type": "string" }
          }
        }
      ]
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "reference_evidence", "character_template", "style_direction", "gate_decision", "output_record"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
