{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/output-record.schema.json",
  "title": "OutputRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_record_id",
    "project_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "medium_plan_id",
    "brief_id",
    "prompt_plan_id",
    "target_media_type",
    "output_artifact",
    "origin",
    "generation",
    "review_state",
    "acceptance_state",
    "traceability_summary",
    "created_at"
  ],
  "properties": {
    "output_record_id": { "type": "string", "pattern": "^out_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "medium_plan_id": { "type": "string", "pattern": "^(imp|smp|vmp|tmp|mmp)_[a-zA-Z0-9_-]+$" },
    "brief_id": { "type": "string", "pattern": "^brief_[a-zA-Z0-9_-]+$" },
    "prompt_plan_id": { "type": "string", "pattern": "^plan_[a-zA-Z0-9_-]+$" },
    "prompt_branch_set_id": { "type": ["string", "null"], "pattern": "^pbs_[a-zA-Z0-9_-]+$" },
    "prompt_branch_id": { "type": ["string", "null"], "pattern": "^branch_[a-zA-Z0-9_-]+$" },
    "prompt_variant_type": { "type": ["string", "null"], "enum": ["faithful", "amplified", "minimal", null] },
    "target_media_type": { "type": "string", "enum": ["image", "sound", "video", "text", "mixed_media"] },
    "output_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "uri_or_path", "mime_type", "description", "rights_notes"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^artifact_[a-zA-Z0-9_-]+$" },
        "artifact_kind": { "type": "string", "enum": ["image", "audio", "video", "text", "mixed_media_package"] },
        "uri_or_path": { "type": "string" },
        "mime_type": { "type": "string" },
        "description": { "type": "string" },
        "rights_notes": { "type": "string" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_type", "created_by", "generation_approval_ref"],
      "properties": {
        "origin_type": {
          "type": "string",
          "enum": ["provider_generated", "artist_imported", "agent_drafted", "human_edited"]
        },
        "created_by": { "type": "string" },
        "generation_approval_ref": { "type": ["string", "null"] }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "settings", "seed", "estimated_cost", "actual_cost"],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "settings": { "type": "object" },
        "seed": { "type": ["string", "number", "null"] },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
        "actual_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "review_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_critic_review_required", "review_record_id", "review_status"],
      "properties": {
        "output_critic_review_required": { "type": "boolean" },
        "review_record_id": { "type": ["string", "null"], "pattern": "^review_[a-zA-Z0-9_-]+$" },
        "review_status": { "type": "string", "enum": ["not_reviewed", "approved", "revise", "blocked", "waived"] }
      }
    },
    "acceptance_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_acceptance_status", "accepted_work", "artist_decision_ref", "waiver_reason"],
      "properties": {
        "output_acceptance_status": { "type": "string", "enum": ["pending", "accepted", "rejected", "revise", "archived", "exported"] },
        "accepted_work": { "type": "boolean" },
        "artist_decision_ref": { "type": ["string", "null"] },
        "waiver_reason": { "type": ["string", "null"] }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "transformation_brief", "beat_plan", "medium_plan", "creative_brief", "prompt_plan", "prompt_branch_set", "prompt_branch", "prompt_variant", "review_record", "gate_decision"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
