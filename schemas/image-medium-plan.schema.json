{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/image-medium-plan.schema.json",
  "title": "ImageMediumPlan",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["medium_output_shape_recommendation"],
        "properties": {
          "medium_output_shape_recommendation": {
            "properties": {
              "accepted_shape": { "const": "single_image" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "presentation_mode": { "const": "single_image" }
        }
      }
    },
    {
      "if": {
        "required": ["medium_output_shape_recommendation"],
        "properties": {
          "medium_output_shape_recommendation": {
            "properties": {
              "accepted_shape": { "const": "compressed_arc" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "presentation_mode": { "const": "compressed_arc" }
        }
      }
    },
    {
      "if": {
        "required": ["medium_output_shape_recommendation"],
        "properties": {
          "medium_output_shape_recommendation": {
            "properties": {
              "accepted_shape": { "const": "image_series" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "presentation_mode": { "const": "image_series" }
        }
      }
    }
  ],
  "required": [
    "image_medium_plan_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "target_media_type",
    "story_mode",
    "workflow_scale_routing",
    "symbology_direction",
    "presentation_mode",
    "style_direction",
    "visual_dynamics",
    "image_roles",
    "series_plan",
    "gates",
    "review_requirements",
    "traceability_summary"
  ],
  "properties": {
    "image_medium_plan_id": { "type": "string", "pattern": "^imp_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "target_media_type": { "type": "string", "const": "image" },
    "story_mode": { "$ref": "#/$defs/story_mode" },
    "workflow_scale_routing": { "$ref": "#/$defs/workflow_scale_routing" },
    "character_reference_strategy": { "$ref": "#/$defs/character_reference_strategy" },
    "visual_reference_sheet_strategy": { "$ref": "#/$defs/visual_reference_sheet_strategy" },
    "symbology_direction": { "$ref": "#/$defs/symbology_direction" },
    "medium_output_shape_recommendation": { "$ref": "#/$defs/medium_output_shape_recommendation" },
    "presentation_mode": {
      "type": "string",
      "enum": ["single_image", "compressed_arc", "image_series"]
    },
    "style_direction": { "$ref": "#/$defs/style_direction" },
    "visual_dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_visual_engine", "active_visual_tensions", "minimum_tension_criteria", "style_visual_conflicts"],
      "properties": {
        "target_visual_engine": { "type": "string" },
        "active_visual_tensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tension_pair_summary" }
        },
        "minimum_tension_criteria": { "$ref": "#/$defs/minimum_visual_tension_criteria" },
        "style_visual_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conflict", "adaptation", "requires_artist_approval"],
            "properties": {
              "conflict": { "type": "string" },
              "adaptation": { "type": "string" },
              "requires_artist_approval": { "type": "boolean" }
            }
          }
        }
      }
    },
    "image_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image_role" }
    },
    "series_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_series", "requires_series_approval", "calibration_required", "style_progression"],
      "properties": {
        "is_series": { "type": "boolean" },
        "requires_series_approval": { "type": "boolean" },
        "calibration_required": { "type": "boolean" },
        "style_progression": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbology_gate", "presentation_gate", "style_gate", "detail_gate"],
      "properties": {
        "symbology_gate": { "$ref": "#/$defs/gate_status" },
        "presentation_gate": { "$ref": "#/$defs/gate_status" },
        "style_gate": { "$ref": "#/$defs/gate_status" },
        "detail_gate": { "$ref": "#/$defs/gate_status" }
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_reviewer_required", "art_critic_required", "prompt_critic_required"],
      "properties": {
        "beat_reviewer_required": { "type": "boolean" },
        "art_critic_required": { "type": "boolean", "const": true },
        "prompt_critic_required": { "type": "boolean", "const": true }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    }
  },
  "$defs": {
    "story_mode": {
      "type": "string",
      "enum": ["single_beat", "beat_pair", "three_part_sequence", "sequence", "scene", "arc", "world"]
    },
    "gate_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "complete", "skipped", "unconfirmed"]
    },
    "image_output_shape": {
      "type": "string",
      "enum": ["single_image", "compressed_arc", "image_series"]
    },
    "workflow_scale_level": {
      "type": "string",
      "enum": ["compact_artifact", "structured_single_artifact", "cumulative_work", "full_long_form_project"]
    },
    "workflow_scale_support": {
      "type": "string",
      "enum": [
        "core_pipeline",
        "medium_section_plan",
        "cultural_format_structure",
        "long_work_stewardship",
        "long_work_parts",
        "long_work_readiness",
        "long_work_checkpoints",
        "stewardship_views",
        "plot_tracker",
        "character_sheets",
        "world_building",
        "chapter_or_scene_briefs",
        "style_guide",
        "extraction_verification",
        "synthesis_checkpoints",
        "publishing_or_completion_audit",
        "collection_coherence_review"
      ]
    },
    "workflow_scale_trigger_signal": {
      "type": "string",
      "enum": [
        "artist_requested_compact_output",
        "artist_requested_long_form",
        "artist_requested_sequence_or_series",
        "single_artifact_can_hold_movement",
        "internal_sections_or_movements_needed",
        "dependent_parts_needed",
        "durable_canon_needed",
        "recurring_characters_needed",
        "world_rules_or_timeline_needed",
        "subplots_or_open_threads_needed",
        "voice_or_style_continuity_needed",
        "extraction_verification_needed",
        "synthesis_or_batch_generation_needed",
        "publication_or_completion_audit_needed",
        "collection_without_sequence"
      ]
    },
    "workflow_scale_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_level", "rationale", "trigger_signals", "activated_supports", "skipped_supports", "reroute_triggers"],
      "properties": {
        "scale_level": { "$ref": "#/$defs/workflow_scale_level" },
        "rationale": { "type": "string", "minLength": 1 },
        "trigger_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_trigger_signal" }
        },
        "activated_supports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "skipped_supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflow_scale_support" }
        },
        "reroute_triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strategy_status": {
      "type": "string",
      "enum": ["accepted", "accepted_partial", "declined", "deferred", "not_applicable"]
    },
    "character_reference_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_ref", "character_template_refs", "visual_reference_sheet_plan_refs", "notes"],
      "properties": {
        "status": { "$ref": "#/$defs/strategy_status" },
        "decision_ref": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" },
        "character_template_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^char_[a-zA-Z0-9_-]+$" }
        },
        "visual_reference_sheet_plan_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^vrs_[a-zA-Z0-9_-]+$" }
        },
        "notes": { "type": "string" }
      }
    },
    "visual_reference_sheet_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_ref", "visual_reference_sheet_plan_refs", "notes"],
      "properties": {
        "status": { "$ref": "#/$defs/strategy_status" },
        "decision_ref": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" },
        "visual_reference_sheet_plan_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^vrs_[a-zA-Z0-9_-]+$" }
        },
        "notes": { "type": "string" }
      }
    },
    "medium_output_shape_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_shape",
        "recommended_shape",
        "accepted_shape",
        "rationale",
        "alternatives_considered",
        "tradeoffs",
        "conflict"
      ],
      "properties": {
        "requested_shape": { "type": ["string", "null"], "minLength": 1 },
        "recommended_shape": { "$ref": "#/$defs/image_output_shape" },
        "accepted_shape": { "$ref": "#/$defs/image_output_shape" },
        "rationale": { "type": "string", "minLength": 1 },
        "alternatives_considered": {
          "type": "array",
          "items": { "$ref": "#/$defs/image_output_shape" }
        },
        "tradeoffs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflict": { "$ref": "#/$defs/medium_output_shape_conflict" }
      }
    },
    "medium_output_shape_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_conflict", "conflict_summary", "resolution", "gate_decision_id"],
      "properties": {
        "has_conflict": { "type": "boolean" },
        "conflict_summary": { "type": ["string", "null"], "minLength": 1 },
        "resolution": {
          "type": "string",
          "enum": ["not_needed", "accepted_recommendation", "kept_requested_shape", "revised_shape", "proceeded_unconfirmed", "waived"]
        },
        "gate_decision_id": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" }
      }
    },
    "symbology_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "primary_symbolic_representation", "confirmation_status", "rationale", "avoid"],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "symbology_board", "agent_recommended"] },
        "primary_symbolic_representation": { "type": "string" },
        "confirmation_status": { "type": "string", "enum": ["artist_specified", "confirmed", "unconfirmed"] },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "style_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "primary_style", "style_modifiers", "confirmation_status", "rationale", "avoid"],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "style_interview", "style_board", "agent_recommended"] },
        "primary_style": { "type": "string" },
        "style_modifiers": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "confirmation_status": { "type": "string", "enum": ["artist_specified", "confirmed", "unconfirmed"] },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tension_pair_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tension_intensity", "translation_notes"],
      "properties": {
        "name": { "type": "string" },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "translation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "minimum_visual_tension_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_image_requirement",
        "series_requirement",
        "minimum_active_visual_tensions",
        "minimum_primary_tension_intensity",
        "minimum_adjacent_amplitude_shift_count",
        "minimum_adjacent_tension_shift_count",
        "reviewer_instruction"
      ],
      "properties": {
        "single_image_requirement": { "type": "string", "minLength": 1 },
        "series_requirement": { "type": "string", "minLength": 1 },
        "minimum_active_visual_tensions": { "type": "integer", "minimum": 1 },
        "minimum_primary_tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_adjacent_amplitude_shift_count": { "type": "integer", "minimum": 0 },
        "minimum_adjacent_tension_shift_count": { "type": "integer", "minimum": 0 },
        "reviewer_instruction": { "type": "string", "minLength": 1 }
      }
    },
    "image_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_role_id",
        "beat_id",
        "key_emotional_movement_id",
        "reference_refs_used",
        "role_label",
        "composition_intent",
        "communication_intent",
        "expectation_turn_translation",
        "intended_feeling",
        "emotional_payload",
        "tension_profile",
        "shot_design",
        "amplitude_profile"
      ],
      "properties": {
        "image_role_id": { "type": "string", "pattern": "^imgrole_[a-zA-Z0-9_-]+$" },
        "beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "key_emotional_movement_id": { "type": "string", "pattern": "^kem_[a-zA-Z0-9_-]+$" },
        "reference_refs_used": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(refsub|refout|refimg|vrs|char|out)_[a-zA-Z0-9_-]+$" }
        },
        "role_label": { "type": "string" },
        "composition_intent": { "type": "string", "minLength": 1 },
        "communication_intent": { "type": "string", "minLength": 1 },
        "expectation_turn_translation": { "type": "string", "minLength": 1 },
        "intended_feeling": { "type": "string", "minLength": 1 },
        "emotional_payload": { "type": "string", "minLength": 1 },
        "tension_profile": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tension_pair_summary" }
        },
        "shot_design": { "$ref": "#/$defs/shot_design" },
        "distinction_notes": { "$ref": "#/$defs/distinction_notes" },
        "amplitude_profile": { "$ref": "#/$defs/amplitude_profile" }
      }
    },
    "shot_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_scale",
        "camera_angle",
        "visual_emphasis",
        "composition_strategy",
        "emotional_rationale",
        "avoid"
      ],
      "properties": {
        "shot_scale": {
          "type": "string",
          "enum": [
            "extreme_close_up",
            "close_up",
            "medium_close_up",
            "medium_shot",
            "medium_wide",
            "wide",
            "extreme_wide"
          ]
        },
        "camera_angle": {
          "type": "string",
          "enum": [
            "eye_level",
            "high_angle",
            "low_angle",
            "overhead",
            "dutch_angle",
            "profile",
            "over_the_shoulder",
            "point_of_view"
          ]
        },
        "visual_emphasis": {
          "type": "string",
          "enum": [
            "face_reaction",
            "hands_or_object",
            "body_action",
            "relationship",
            "environment",
            "absence_negative_space",
            "symbolic_detail",
            "scale_consequence"
          ]
        },
        "composition_strategy": { "type": "string", "minLength": 1 },
        "emotional_rationale": { "type": "string", "minLength": 1 },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "distinction_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_previous_role", "composition_shift", "communication_shift", "tension_shift"],
      "properties": {
        "from_previous_role": { "type": "string", "minLength": 1 },
        "composition_shift": { "type": "string", "minLength": 1 },
        "communication_shift": { "type": "string", "minLength": 1 },
        "tension_shift": { "type": "string", "minLength": 1 }
      }
    },
    "amplitude_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing_distance", "subject_scale", "visual_density", "motion_energy", "spatial_openness", "detail_intensity", "emotional_pressure"],
      "properties": {
        "framing_distance": { "type": "number", "minimum": 0, "maximum": 1 },
        "subject_scale": { "type": "number", "minimum": 0, "maximum": 1 },
        "visual_density": { "type": "number", "minimum": 0, "maximum": 1 },
        "motion_energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "spatial_openness": { "type": "number", "minimum": 0, "maximum": 1 },
        "detail_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "emotional_pressure": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "reference_evidence", "transformation_brief", "beat_plan", "beat", "tension_point", "gate_decision"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
