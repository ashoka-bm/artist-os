{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/image-medium-plan.schema.json",
  "title": "ImageMediumPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_medium_plan_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "target_media_type",
    "story_mode",
    "symbology_direction",
    "presentation_mode",
    "style_direction",
    "visual_dynamics",
    "image_roles",
    "series_plan",
    "gates",
    "review_requirements",
    "traceability_summary"
  ],
  "properties": {
    "image_medium_plan_id": { "type": "string", "pattern": "^imp_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "target_media_type": { "type": "string", "const": "image" },
    "story_mode": { "$ref": "#/$defs/story_mode" },
    "symbology_direction": { "$ref": "#/$defs/symbology_direction" },
    "presentation_mode": {
      "type": "string",
      "enum": ["single_image", "compressed_arc", "image_series"]
    },
    "style_direction": { "$ref": "#/$defs/style_direction" },
    "visual_dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_visual_engine", "active_visual_tensions", "minimum_tension_criteria", "style_visual_conflicts"],
      "properties": {
        "target_visual_engine": { "type": "string" },
        "active_visual_tensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/tension_pair_summary" }
        },
        "minimum_tension_criteria": { "$ref": "#/$defs/minimum_visual_tension_criteria" },
        "style_visual_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conflict", "adaptation", "requires_artist_approval"],
            "properties": {
              "conflict": { "type": "string" },
              "adaptation": { "type": "string" },
              "requires_artist_approval": { "type": "boolean" }
            }
          }
        }
      }
    },
    "image_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image_role" }
    },
    "series_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_series", "requires_series_approval", "calibration_required", "style_progression"],
      "properties": {
        "is_series": { "type": "boolean" },
        "requires_series_approval": { "type": "boolean" },
        "calibration_required": { "type": "boolean" },
        "style_progression": { "type": "string" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbology_gate", "presentation_gate", "style_gate", "detail_gate"],
      "properties": {
        "symbology_gate": { "$ref": "#/$defs/gate_status" },
        "presentation_gate": { "$ref": "#/$defs/gate_status" },
        "style_gate": { "$ref": "#/$defs/gate_status" },
        "detail_gate": { "$ref": "#/$defs/gate_status" }
      }
    },
    "review_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_reviewer_required", "art_critic_required", "prompt_critic_required"],
      "properties": {
        "beat_reviewer_required": { "type": "boolean" },
        "art_critic_required": { "type": "boolean", "const": true },
        "prompt_critic_required": { "type": "boolean", "const": true }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    }
  },
  "$defs": {
    "story_mode": {
      "type": "string",
      "enum": ["single_beat", "beat_pair", "three_part_sequence", "sequence", "scene", "arc", "world"]
    },
    "gate_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "complete", "skipped", "unconfirmed"]
    },
    "symbology_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "primary_symbolic_representation", "confirmation_status", "rationale", "avoid"],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "symbology_board", "agent_recommended"] },
        "primary_symbolic_representation": { "type": "string" },
        "confirmation_status": { "type": "string", "enum": ["artist_specified", "confirmed", "unconfirmed"] },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "style_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_method", "primary_style", "style_modifiers", "confirmation_status", "rationale", "avoid"],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "style_interview", "style_board", "agent_recommended"] },
        "primary_style": { "type": "string" },
        "style_modifiers": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
        "confirmation_status": { "type": "string", "enum": ["artist_specified", "confirmed", "unconfirmed"] },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tension_pair_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tension_intensity", "translation_notes"],
      "properties": {
        "name": { "type": "string" },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "translation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "minimum_visual_tension_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_image_requirement",
        "series_requirement",
        "minimum_active_visual_tensions",
        "minimum_primary_tension_intensity",
        "minimum_adjacent_amplitude_shift_count",
        "minimum_adjacent_tension_shift_count",
        "reviewer_instruction"
      ],
      "properties": {
        "single_image_requirement": { "type": "string", "minLength": 1 },
        "series_requirement": { "type": "string", "minLength": 1 },
        "minimum_active_visual_tensions": { "type": "integer", "minimum": 1 },
        "minimum_primary_tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_adjacent_amplitude_shift_count": { "type": "integer", "minimum": 0 },
        "minimum_adjacent_tension_shift_count": { "type": "integer", "minimum": 0 },
        "reviewer_instruction": { "type": "string", "minLength": 1 }
      }
    },
    "image_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_role_id",
        "beat_id",
        "key_emotional_movement_id",
        "role_label",
        "composition_intent",
        "communication_intent",
        "expectation_turn_translation",
        "intended_feeling",
        "emotional_payload",
        "tension_profile",
        "shot_design",
        "amplitude_profile"
      ],
      "properties": {
        "image_role_id": { "type": "string", "pattern": "^imgrole_[a-zA-Z0-9_-]+$" },
        "beat_id": { "type": "string", "pattern": "^beat_[a-zA-Z0-9_-]+$" },
        "key_emotional_movement_id": { "type": "string", "pattern": "^kem_[a-zA-Z0-9_-]+$" },
        "role_label": { "type": "string" },
        "composition_intent": { "type": "string", "minLength": 1 },
        "communication_intent": { "type": "string", "minLength": 1 },
        "expectation_turn_translation": { "type": "string", "minLength": 1 },
        "intended_feeling": { "type": "string", "minLength": 1 },
        "emotional_payload": { "type": "string", "minLength": 1 },
        "tension_profile": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tension_pair_summary" }
        },
        "shot_design": { "$ref": "#/$defs/shot_design" },
        "distinction_notes": { "$ref": "#/$defs/distinction_notes" },
        "amplitude_profile": { "$ref": "#/$defs/amplitude_profile" }
      }
    },
    "shot_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_scale",
        "camera_angle",
        "visual_emphasis",
        "composition_strategy",
        "emotional_rationale",
        "avoid"
      ],
      "properties": {
        "shot_scale": {
          "type": "string",
          "enum": [
            "extreme_close_up",
            "close_up",
            "medium_close_up",
            "medium_shot",
            "medium_wide",
            "wide",
            "extreme_wide"
          ]
        },
        "camera_angle": {
          "type": "string",
          "enum": [
            "eye_level",
            "high_angle",
            "low_angle",
            "overhead",
            "dutch_angle",
            "profile",
            "over_the_shoulder",
            "point_of_view"
          ]
        },
        "visual_emphasis": {
          "type": "string",
          "enum": [
            "face_reaction",
            "hands_or_object",
            "body_action",
            "relationship",
            "environment",
            "absence_negative_space",
            "symbolic_detail",
            "scale_consequence"
          ]
        },
        "composition_strategy": { "type": "string", "minLength": 1 },
        "emotional_rationale": { "type": "string", "minLength": 1 },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "distinction_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_previous_role", "composition_shift", "communication_shift", "tension_shift"],
      "properties": {
        "from_previous_role": { "type": "string", "minLength": 1 },
        "composition_shift": { "type": "string", "minLength": 1 },
        "communication_shift": { "type": "string", "minLength": 1 },
        "tension_shift": { "type": "string", "minLength": 1 }
      }
    },
    "amplitude_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing_distance", "subject_scale", "visual_density", "motion_energy", "spatial_openness", "detail_intensity", "emotional_pressure"],
      "properties": {
        "framing_distance": { "type": "number", "minimum": 0, "maximum": 1 },
        "subject_scale": { "type": "number", "minimum": 0, "maximum": 1 },
        "visual_density": { "type": "number", "minimum": 0, "maximum": 1 },
        "motion_energy": { "type": "number", "minimum": 0, "maximum": 1 },
        "spatial_openness": { "type": "number", "minimum": 0, "maximum": 1 },
        "detail_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "emotional_pressure": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "reference_evidence", "transformation_brief", "beat_plan", "beat", "tension_point", "gate_decision"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
