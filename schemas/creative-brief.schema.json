{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/creative-brief.schema.json",
  "title": "CreativeBriefRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "artist_meaning",
    "formal_observations",
    "symbology_direction",
    "style_direction",
    "visual_dynamics",
    "core_tension_pairs",
    "emotional_qualities",
    "poetic_density_notes",
    "beats",
    "series_recommendation",
    "transformation_constraints"
  ],
  "properties": {
    "brief_id": { "type": "string", "pattern": "^brief_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "artist_meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why_it_matters", "must_preserve", "may_transform"],
      "properties": {
        "why_it_matters": { "type": "string" },
        "must_preserve": { "type": "array", "items": { "type": "string" } },
        "may_transform": { "type": "array", "items": { "type": "string" } }
      }
    },
    "formal_observations": { "type": "array", "items": { "type": "string" } },
    "symbology_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_method",
        "primary_symbolic_representation",
        "confirmation_status",
        "alternatives_considered",
        "rationale",
        "avoid"
      ],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "symbology_board", "agent_recommended"] },
        "primary_symbolic_representation": { "type": "string" },
        "confirmation_status": {
          "type": "string",
          "enum": ["artist_specified", "confirmed", "unconfirmed"]
        },
        "alternatives_considered": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    },
    "style_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_method",
        "style_family",
        "style_mode",
        "primary_style",
        "style_modifiers",
        "confirmation_status",
        "rationale",
        "avoid",
        "style_conflicts"
      ],
      "properties": {
        "selection_method": { "type": "string", "enum": ["artist_specified", "style_interview", "agent_recommended"] },
        "style_family": { "type": "string" },
        "style_mode": { "type": "string" },
        "primary_style": { "type": "string" },
        "confirmation_status": {
          "type": "string",
          "enum": ["artist_specified", "confirmed", "unconfirmed"]
        },
        "style_modifiers": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "wondermint_subcategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "style_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conflict", "proposed_adaptation", "requires_artist_approval"],
            "properties": {
              "conflict": { "type": "string" },
              "proposed_adaptation": { "type": "string" },
              "requires_artist_approval": { "type": "boolean" }
            }
          }
        }
      }
    },
    "visual_dynamics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_visual_tensions"],
      "properties": {
        "active_visual_tensions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/visual_tension_pair_record" }
        },
        "conditional_visual_tensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/visual_tension_pair_record" }
        }
      }
    },
    "core_tension_pairs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attraction_repulsion",
        "proximity_distance",
        "order_chaos",
        "stillness_motion",
        "legibility_opacity",
        "control_surrender",
        "safety_threat",
        "presence_absence"
      ],
      "properties": {
        "attraction_repulsion": { "$ref": "#/$defs/tension_pair_record" },
        "proximity_distance": { "$ref": "#/$defs/tension_pair_record" },
        "order_chaos": { "$ref": "#/$defs/tension_pair_record" },
        "stillness_motion": { "$ref": "#/$defs/tension_pair_record" },
        "legibility_opacity": { "$ref": "#/$defs/tension_pair_record" },
        "control_surrender": { "$ref": "#/$defs/tension_pair_record" },
        "safety_threat": { "$ref": "#/$defs/tension_pair_record" },
        "presence_absence": { "$ref": "#/$defs/tension_pair_record" }
      }
    },
    "emotional_qualities": { "type": "array", "items": { "type": "string" } },
    "poetic_density_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layered_meanings", "flattening_risks"],
      "properties": {
        "layered_meanings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["detail", "meanings"],
            "properties": {
              "detail": { "type": "string" },
              "meanings": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "flattening_risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after", "value_shift", "emotional_payload", "evidence"],
        "properties": {
          "before": { "type": "string" },
          "after": { "type": "string" },
          "value_shift": { "type": "string" },
          "emotional_payload": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "series_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reason",
        "suggested_images",
        "minimum_tension_criteria",
        "style_progression",
        "calibration",
        "requires_artist_approval"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["single_image", "triptych", "image_series"] },
        "reason": { "type": "string" },
        "suggested_images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image_role",
              "beat_or_tension_point",
              "key_emotional_movement_id",
              "communication_intent",
              "expectation_turn_translation",
              "intended_feeling",
              "emotional_payload",
              "target_visual_engine",
              "tension_profile",
              "series_role_distinction",
              "amplitude_profile"
            ],
            "properties": {
              "image_role": { "type": "string", "minLength": 1 },
              "beat_or_tension_point": { "type": "string", "minLength": 1 },
              "key_emotional_movement_id": { "type": "string", "pattern": "^kem_[a-zA-Z0-9_-]+$" },
              "communication_intent": { "type": "string", "minLength": 1 },
              "expectation_turn_translation": { "type": "string", "minLength": 1 },
              "intended_feeling": { "type": "string", "minLength": 1 },
              "emotional_payload": { "type": "string", "minLength": 1 },
              "target_visual_engine": { "type": "string", "minLength": 1 },
              "tension_profile": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/series_tension_profile" }
              },
              "series_role_distinction": { "$ref": "#/$defs/series_role_distinction" },
              "amplitude_profile": { "$ref": "#/$defs/series_amplitude_profile" }
            }
          }
        },
        "minimum_tension_criteria": { "$ref": "#/$defs/minimum_series_tension_criteria" },
        "style_progression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposed", "progression_summary", "beat_plan_rationale"],
          "properties": {
            "proposed": { "type": "boolean" },
            "progression_summary": { "type": "string" },
            "beat_plan_rationale": { "type": "string" }
          }
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "calibration_image_role", "uses_three_prompt_variants"],
          "properties": {
            "required": { "type": "boolean" },
            "calibration_image_role": { "type": "string" },
            "uses_three_prompt_variants": { "type": "boolean" }
          }
        },
        "requires_artist_approval": { "type": "boolean" }
      }
    },
    "transformation_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_media_type", "preserve", "avoid"],
      "properties": {
        "target_media_type": { "type": "string", "enum": ["image", "audio", "video", "text"] },
        "preserve": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "pole_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presence"],
      "properties": {
        "presence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tension_pair_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["salience", "poles", "tension_intensity", "evidence", "translation_notes"],
      "properties": {
        "salience": { "type": "string", "enum": ["not_salient", "low", "medium", "high"] },
        "poles": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/pole_record" }
        },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "artist_note": { "type": "string" },
        "translation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "visual_tension_pair_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "poles", "tension_intensity", "evidence", "translation_notes"],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "Light / Dark",
            "Saturated / Muted",
            "Warm / Cool",
            "Harmonious / Discordant",
            "Dense / Sparse",
            "Geometric / Organic",
            "Sharp / Diffuse",
            "Linear / Painterly",
            "Textured / Smooth",
            "Representational / Non-Representational",
            "Flat / Deep",
            "Balanced / Unbalanced",
            "Centered / Decentered",
            "Singular / Repetitive",
            "Monumental / Intimate"
          ]
        },
        "poles": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/pole_record" }
        },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "translation_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "series_amplitude_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing_distance",
        "subject_scale",
        "visual_density",
        "motion_energy",
        "spatial_openness",
        "detail_intensity",
        "emotional_pressure",
        "rationale"
      ],
      "properties": {
        "framing_distance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = extreme close-up/intimate crop, 1 = panoramic or very wide framing."
        },
        "subject_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = tiny or fragile subject presence, 1 = monumental or dominant subject presence."
        },
        "visual_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = sparse/minimal field, 1 = crowded/maximal field."
        },
        "motion_energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = still/static, 1 = active/turbulent."
        },
        "spatial_openness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = enclosed/compressed, 1 = open/expansive."
        },
        "detail_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = stripped down/minimal detail, 1 = highly detailed/layered."
        },
        "emotional_pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = quiet/low pressure, 1 = overwhelming/high pressure."
        },
        "rationale": { "type": "string" }
      }
    },
    "series_tension_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tension_intensity", "translation_notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "translation_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "minimum_series_tension_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_image_requirement",
        "series_requirement",
        "minimum_active_tensions_per_image",
        "minimum_primary_tension_intensity",
        "minimum_adjacent_amplitude_shift_count",
        "minimum_adjacent_tension_shift_count",
        "waiver_rule"
      ],
      "properties": {
        "single_image_requirement": { "type": "string", "minLength": 1 },
        "series_requirement": { "type": "string", "minLength": 1 },
        "minimum_active_tensions_per_image": { "type": "integer", "minimum": 1 },
        "minimum_primary_tension_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_adjacent_amplitude_shift_count": { "type": "integer", "minimum": 0 },
        "minimum_adjacent_tension_shift_count": { "type": "integer", "minimum": 0 },
        "waiver_rule": { "type": "string", "minLength": 1 }
      }
    },
    "series_role_distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_in_series",
        "composition_difference",
        "communication_difference",
        "tension_difference"
      ],
      "properties": {
        "role_in_series": { "type": "string", "minLength": 1 },
        "composition_difference": { "type": "string", "minLength": 1 },
        "communication_difference": { "type": "string", "minLength": 1 },
        "tension_difference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
