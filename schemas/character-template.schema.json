{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/character-template.schema.json",
  "title": "CharacterTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "character_template_id",
    "project_id",
    "source_id",
    "artist_meaning_id",
    "version",
    "supersedes_character_template_id",
    "status",
    "character_identity",
    "dramatic_function",
    "voice_behavior",
    "visual_identity",
    "continuity_constraints",
    "visual_reference_sheet_plan_refs",
    "traceability_summary",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "character_template_id": { "type": "string", "pattern": "^char_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "supersedes_character_template_id": {
      "type": ["string", "null"],
      "pattern": "^char_[a-zA-Z0-9_-]+$"
    },
    "status": { "type": "string", "enum": ["draft", "approved", "superseded"] },
    "character_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role_label", "story_function", "first_appearance_ref", "identity_notes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role_label": { "type": "string", "minLength": 1 },
        "story_function": { "type": "string", "minLength": 1 },
        "first_appearance_ref": { "type": ["string", "null"], "minLength": 1 },
        "identity_notes": { "type": "string" }
      }
    },
    "dramatic_function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wants", "fears", "contradictions", "arc_state", "relationship_pressure"],
      "properties": {
        "wants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fears": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contradictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "arc_state": { "type": "string" },
        "relationship_pressure": { "type": "string" }
      }
    },
    "voice_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice_summary", "behavior_cues", "avoid"],
      "properties": {
        "voice_summary": { "type": "string" },
        "behavior_cues": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "avoid": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_description",
        "clothing_costume",
        "distinguishing_features",
        "style_proportion_notes",
        "evidence_status",
        "source_refs"
      ],
      "properties": {
        "physical_description": { "type": "string" },
        "clothing_costume": { "type": "string" },
        "distinguishing_features": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "style_proportion_notes": { "type": "string" },
        "evidence_status": {
          "type": "string",
          "enum": ["artist_provided", "agent_inferred", "reference_sheet_approved", "mixed"]
        },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "continuity_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "authority", "promote_to_long_work_rule"],
        "properties": {
          "constraint": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "enum": ["template_only", "artist_confirmed", "long_work_rule_candidate"] },
          "promote_to_long_work_rule": { "type": "boolean" }
        }
      }
    },
    "visual_reference_sheet_plan_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^vrs_[a-zA-Z0-9_-]+$" }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "path_or_ref"],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": ["source_record", "artist_meaning", "transformation_brief", "beat_plan", "output_record", "asset_metadata", "gate_decision"]
        },
        "ref_id": { "type": "string" },
        "path_or_ref": { "type": "string" }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["artist_meaning", "reference_evidence", "transformation_brief", "beat_plan", "gate_decision", "output_record"]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
