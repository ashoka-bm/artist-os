{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/prompt-plan.schema.json",
  "title": "ProviderNeutralImagePromptPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_plan_id",
    "brief_id",
    "source_id",
    "artist_meaning_id",
    "transformation_brief_id",
    "beat_plan_id",
    "image_medium_plan_id",
    "target_media_type",
    "plan_mode",
    "provider_neutral",
    "visual_boards",
    "symbology_direction_summary",
    "style_direction_summary",
    "target_visual_engine_summary",
    "layout_plan",
    "prompt_variants",
    "series_calibration",
    "approval_refs",
    "traceability_summary",
    "critique_checklist"
  ],
  "properties": {
    "prompt_plan_id": { "type": "string", "pattern": "^plan_[a-zA-Z0-9_-]+$" },
    "brief_id": { "type": "string", "pattern": "^brief_[a-zA-Z0-9_-]+$" },
    "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
    "artist_meaning_id": { "type": "string", "pattern": "^meaning_[a-zA-Z0-9_-]+$" },
    "transformation_brief_id": { "type": "string", "pattern": "^tb_[a-zA-Z0-9_-]+$" },
    "beat_plan_id": { "type": "string", "pattern": "^bp_[a-zA-Z0-9_-]+$" },
    "image_medium_plan_id": { "type": "string", "pattern": "^imp_[a-zA-Z0-9_-]+$" },
    "target_media_type": { "type": "string", "enum": ["image"] },
    "plan_mode": { "type": "string", "enum": ["single_image", "series_calibration", "series_image"] },
    "provider_neutral": { "type": "boolean", "const": true },
    "provider_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider_target" }
    },
    "visual_boards": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual_board_plan" }
    },
    "symbology_direction_summary": { "$ref": "#/$defs/symbology_direction_summary" },
    "style_direction_summary": { "$ref": "#/$defs/style_direction_summary" },
    "target_visual_engine_summary": { "type": "string" },
    "layout_plan": { "$ref": "#/$defs/layout_plan" },
    "prompt_variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/prompt_variant_plan" }
    },
    "series_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_series_calibration",
        "calibration_image_role",
        "uses_three_prompt_variants",
        "requires_artist_approval_before_series"
      ],
      "properties": {
        "is_series_calibration": { "type": "boolean" },
        "calibration_image_role": { "type": "string" },
        "uses_three_prompt_variants": { "type": "boolean" },
        "requires_artist_approval_before_series": { "type": "boolean" }
      }
    },
    "approval_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_critic_review_id", "prompt_lock_gate_id"],
      "properties": {
        "prompt_critic_review_id": { "type": "string", "pattern": "^review_[a-zA-Z0-9_-]+$" },
        "prompt_lock_gate_id": { "type": "string", "pattern": "^gate_[a-zA-Z0-9_-]+$" }
      }
    },
    "traceability_summary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/traceability_note" }
    },
    "critique_checklist": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "layout_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_type", "panel_count", "aspect_ratio", "instructions"],
      "properties": {
        "layout_type": {
          "type": "string",
          "enum": [
            "single_image",
            "three_panel_variant_comparison",
            "series_calibration_image",
            "series_image"
          ]
        },
        "panel_count": { "type": "integer", "minimum": 1 },
        "aspect_ratio": { "type": "string" },
        "composite_image_prompt": {
          "type": "string",
          "description": "Required when layout_type is three_panel_variant_comparison: the single provider-neutral prompt that renders all three intensity panels (Minimal, Faithful/Balanced, Amplified/Maximal) as ONE image, same subject and style throughout. Omit for single_image and series layouts."
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "description": "Final output layout only. Exploration boards are stored in visual_boards. For three_panel_variant_comparison, compare Minimal, Faithful/Balanced, and Amplified/Maximal intensity as one image via composite_image_prompt."
        }
      }
    },
    "provider_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "request_status",
        "provider_prompt_style",
        "parameters",
        "rendered_suffix",
        "rendered_prompts",
        "notes"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "midjourney",
            "niji",
            "stable_diffusion_webui",
            "comfyui",
            "leonardo",
            "openai_image",
            "generic_image_provider"
          ]
        },
        "request_status": {
          "type": "string",
          "enum": ["artist_requested", "agent_recommended", "available_translation"]
        },
        "provider_prompt_style": {
          "type": "string",
          "enum": ["suffix_parameters", "structured_settings", "workflow_settings", "api_fields"]
        },
        "parameters": { "$ref": "#/$defs/provider_parameters" },
        "rendered_suffix": {
          "type": "string",
          "description": "Provider-specific suffix when the provider uses prompt-end parameters, such as Midjourney --ar, --s, --c, --q, --seed, --raw, or --no. Use an empty string for providers that use structured settings instead."
        },
        "rendered_prompts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provider_rendered_prompt" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provider_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "negative_prompt", "seed_policy"],
      "properties": {
        "aspect_ratio": { "type": "string" },
        "negative_prompt": { "type": "array", "items": { "type": "string" } },
        "seed_policy": {
          "type": "string",
          "enum": ["random", "fixed", "reuse_prior_seed", "not_applicable"]
        },
        "seed": { "type": ["integer", "null"], "minimum": 0 },
        "stylize": { "type": ["integer", "null"], "minimum": 0 },
        "chaos": { "type": ["integer", "null"], "minimum": 0 },
        "quality": { "type": ["number", "null"], "minimum": 0 },
        "raw": { "type": ["boolean", "null"] },
        "tile": { "type": ["boolean", "null"] },
        "stop": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "weird": { "type": ["integer", "null"], "minimum": 0 },
        "style_reference": { "type": ["string", "null"] },
        "style_weight": { "type": ["integer", "null"], "minimum": 0 },
        "character_reference": { "type": ["string", "null"] },
        "character_weight": { "type": ["integer", "null"], "minimum": 0 },
        "image_weight": { "type": ["number", "null"], "minimum": 0 },
        "model_version": { "type": ["string", "null"] },
        "custom_suffix_tokens": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provider_rendered_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_type", "prompt_text", "suffix", "full_prompt"],
      "properties": {
        "variant_type": { "type": "string", "enum": ["faithful", "amplified", "minimal"] },
        "prompt_text": { "type": "string", "minLength": 1 },
        "suffix": { "type": "string" },
        "full_prompt": { "type": "string", "minLength": 1 }
      }
    },
    "visual_board_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_type",
        "status",
        "panel_count",
        "layout",
        "composite_image_prompt",
        "requires_generation_approval",
        "selected_option_label",
        "options"
      ],
      "properties": {
        "board_type": { "type": "string", "enum": ["symbology_board", "style_mosaic_board"] },
        "status": { "type": "string", "enum": ["proposed", "drafted", "generated", "selected", "skipped"] },
        "panel_count": { "type": "integer", "minimum": 3, "maximum": 6 },
        "layout": { "type": "string", "description": "Grid layout for the single comparison image, e.g. \"2x3\". No more than three cells per row." },
        "composite_image_prompt": {
          "type": "string",
          "minLength": 1,
          "description": "The single provider-neutral prompt that renders the whole board as ONE image: a labeled grid with one option per cell. This is the board's primary deliverable. Never one prompt per option, never multiple images. Symbology boards: every cell is black-and-white line art of the subject only, no style. Style boards: every tile holds the same locked symbology subject and varies only style."
        },
        "requires_generation_approval": { "type": "boolean" },
        "selected_option_label": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/visual_board_option" }
        }
      }
    },
    "visual_board_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "visual_prompt",
        "decision_focus",
        "traceability_notes",
        "risks"
      ],
      "properties": {
        "label": { "type": "string" },
        "visual_prompt": { "type": "string", "description": "The content of this single cell within the composite grid image — what cell N depicts. Not a standalone image prompt; it is composed into composite_image_prompt." },
        "decision_focus": { "type": "string" },
        "traceability_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "symbology_direction_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_symbolic_representation", "avoid"],
      "properties": {
        "primary_symbolic_representation": { "type": "string" },
        "avoid": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "style_direction_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_style", "style_modifiers", "style_conflicts"],
      "properties": {
        "primary_style": { "type": "string" },
        "style_modifiers": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "style_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["conflict", "adaptation"],
            "properties": {
              "conflict": { "type": "string" },
              "adaptation": { "type": "string" }
            }
          }
        }
      }
    },
    "prompt_variant_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_type",
        "variant_test_axis_label",
        "variant_differentiators",
        "prompt_text",
        "negative_constraints",
        "derived_symbols",
        "traceability_notes",
        "critique_checklist"
      ],
      "properties": {
        "variant_type": { "type": "string", "enum": ["faithful", "amplified", "minimal"] },
        "variant_test_axis_label": { "type": "string" },
        "variant_differentiators": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt_text": { "type": "string", "minLength": 1 },
        "negative_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "derived_symbols": {
          "type": "array",
          "items": { "$ref": "#/$defs/derived_symbol" }
        },
        "traceability_notes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        },
        "critique_checklist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "derived_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "purpose", "traces_to"],
      "properties": {
        "symbol": { "type": "string" },
        "purpose": { "type": "string" },
        "traces_to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceability_note" }
        }
      }
    },
    "traceability_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_ref", "note"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "artist_meaning",
            "transformation_brief",
            "beat_plan",
            "medium_plan",
            "reference_evidence",
            "core_tension_pair",
            "active_visual_tension",
            "emotional_quality",
            "beat",
            "tension_point",
            "poetic_density_note",
            "symbology_direction",
            "style_direction",
            "visual_board",
            "critical_heuristic"
          ]
        },
        "source_ref": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
