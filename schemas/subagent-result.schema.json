{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/subagent-result.schema.json",
  "title": "SubagentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "upstream_records_used",
    "findings",
    "finding_fingerprints",
    "confidence",
    "traceability_notes",
    "risk_notes",
    "open_questions",
    "validation_notes",
    "recommended_next_action"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/$defs/status" },
    "upstream_records_used": {
      "type": "object",
      "properties": {
        "source_record_id": { "type": "string" },
        "artist_meaning_id": { "type": "string" },
        "transformation_brief_id": { "type": "string" },
        "beat_plan_id": { "type": "string" },
        "medium_plan_id": { "type": "string" },
        "creative_brief_id": { "type": "string" },
        "prompt_plan_id": { "type": "string" },
        "text_generation_plan_id": { "type": "string" },
        "output_record_id": { "type": "string" }
      }
    },
    "draft_artifact": { "type": "object" },
    "findings": {
      "type": "array",
      "items": { "type": "object" }
    },
    "finding_fingerprints": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding_fingerprint" }
    },
    "confidence": { "$ref": "#/$defs/confidence" },
    "traceability_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": { "$ref": "#/$defs/recommended_next_action" }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "needs_conductor_decision",
        "blocked_by_missing_input",
        "blocked_by_policy",
        "invalid_upstream_packet",
        "failed",
        "rate_limited"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "recommended_next_action": {
      "type": "string",
      "enum": ["integrate", "revise_packet", "escalate_open_questions", "discard"]
    },
    "finding_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "location_or_field", "upstream_rule", "claimed_drift"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "location_or_field": { "type": "string", "minLength": 1 },
        "upstream_rule": { "type": "string", "minLength": 1 },
        "claimed_drift": { "type": "string", "minLength": 1 }
      }
    }
  }
}
