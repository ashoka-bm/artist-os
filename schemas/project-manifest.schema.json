{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/project-manifest.schema.json",
  "title": "ArtistOSProjectManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "title",
    "status",
    "current_stage",
    "created_at",
    "updated_at",
    "paths",
    "decisions",
    "assets"
  ],
  "properties": {
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "title": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "complete", "archived"]
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "source",
        "interpretation",
        "visualization_symbolic",
        "style",
        "detail",
        "brief_review",
        "prompt_plan",
        "generation",
        "critique",
        "complete"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" },
    "artist_library": { "$ref": "#/$defs/artist_library_state" },
    "feedback_state": { "$ref": "#/$defs/feedback_state" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_dir",
        "events",
        "source_record",
        "meaning_interview",
        "creative_brief_record",
        "prompt_plan"
      ],
      "properties": {
        "project_dir": { "type": "string" },
        "events": { "type": "string" },
        "source_record": { "type": "string" },
        "reference_text": { "type": "string" },
        "artist_meaning": { "type": "string" },
        "meaning_interview": { "type": "string" },
        "transformation_brief": { "type": "string" },
        "beat_plan": { "type": "string" },
        "long_work_stewardship_records_dir": { "type": "string" },
        "image_medium_plan": { "type": "string" },
        "sound_medium_plan": { "type": "string" },
        "interpretation_gate": { "type": "string" },
        "symbology_gate": { "type": "string" },
        "style_gate": { "type": "string" },
        "detail_gate": { "type": "string" },
        "creative_brief_draft": { "type": "string" },
        "creative_brief_record": { "type": "string" },
        "prompt_plan": { "type": "string" },
        "prompt_branch_set": { "type": "string" },
        "output_records_dir": { "type": "string" },
        "critiques_dir": { "type": "string" },
        "assets_dir": { "type": "string" },
        "exports_dir": { "type": "string" }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interpretation_status",
        "symbology_status",
        "style_status",
        "detail_status"
      ],
      "properties": {
        "interpretation_status": { "$ref": "#/$defs/stage_status" },
        "symbology_status": { "$ref": "#/$defs/stage_status" },
        "style_status": { "$ref": "#/$defs/stage_status" },
        "detail_status": { "$ref": "#/$defs/stage_status" },
        "selected_symbology": { "type": "string" },
        "presentation_mode": {
          "type": "string",
          "enum": ["single_image", "compressed_arc", "image_series", "unselected"]
        },
        "selected_style": { "type": "string" },
        "selected_detail_mode": {
          "type": "string",
          "enum": ["minimal", "faithful_balanced", "amplified_maximal", "combined", "unselected"]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset_record" }
    }
  },
  "$defs": {
    "artist_library_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_state"],
      "properties": {
        "project_dir": { "type": "string" },
        "project_pointer_path": { "type": "string" },
        "project_pointer_state": {
          "type": "string",
          "enum": ["not_created", "present", "missing", "invalid", "retargeted"]
        },
        "project_pointer_project_id": { "type": ["string", "null"], "pattern": "^proj_[a-zA-Z0-9_-]+$" },
        "visible_state": { "type": "string", "enum": ["not_created", "present", "visible_missing"] },
        "last_checked_at": { "type": "string", "format": "date-time" },
        "user_facing_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/user_facing_file" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "visible_state": { "const": "present" } },
            "required": ["visible_state"]
          },
          "then": {
            "required": [
              "project_dir",
              "project_pointer_path",
              "project_pointer_state",
              "project_pointer_project_id"
            ],
            "properties": {
              "project_pointer_state": { "const": "present" }
            }
          }
        }
      ]
    },
    "user_facing_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_role", "status"],
      "properties": {
        "path": { "type": "string" },
        "file_role": { "type": "string", "enum": ["review_draft", "accepted_work", "readable_summary", "personal_library_note"] },
        "status": { "type": "string", "enum": ["current", "missing", "stale", "archived"] },
        "output_record_id": { "type": ["string", "null"], "pattern": "^out_[a-zA-Z0-9_-]+$" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "feedback_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_review_status"],
      "properties": {
        "feedback_log_path": { "type": "string" },
        "learning_review_status": { "type": "string", "enum": ["not_applicable", "pending", "complete"] },
        "learning_reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "learning_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/learning_ref" }
        },
        "performance_signal_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/performance_signal_ref" }
        }
      }
    },
    "learning_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "learning_type", "path", "status"],
      "properties": {
        "ref_id": { "type": "string" },
        "learning_type": { "type": "string", "enum": ["candidate", "soft", "hard"] },
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "superseded", "archived"] }
      }
    },
    "performance_signal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "path", "status"],
      "properties": {
        "signal_id": { "type": "string" },
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "superseded", "archived"] }
      }
    },
    "stage_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "complete", "skipped", "unconfirmed"]
    },
    "asset_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "stage", "path", "metadata_path", "status"],
      "properties": {
        "asset_id": { "type": "string" },
        "asset_type": {
          "type": "string",
          "enum": ["reference", "board", "generated", "final", "export"]
        },
        "stage": { "type": "string" },
        "path": { "type": "string" },
        "metadata_path": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["proposed", "generated", "imported", "accepted", "rejected", "archived"]
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
