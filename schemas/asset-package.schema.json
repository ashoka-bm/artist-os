{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artist-generation.local/schemas/asset-package.schema.json",
  "title": "AssetPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_package_id",
    "project_id",
    "package_format_id",
    "package_format_ref",
    "cross_medium_plan_ref",
    "status",
    "slots",
    "provider_boundary",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "asset_package_id": { "type": "string", "pattern": "^assetpkg_[a-zA-Z0-9_-]+$" },
    "project_id": { "type": "string", "pattern": "^proj_[a-zA-Z0-9_-]+$" },
    "package_format_id": {
      "type": "string",
      "enum": ["album", "article_with_photos", "video_with_soundtrack"]
    },
    "package_format_ref": { "type": "string" },
    "cross_medium_plan_ref": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["draft", "complete", "partial"] },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package_slot" }
    },
    "provider_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arranges_only", "calls_provider"],
      "properties": {
        "arranges_only": { "const": true },
        "calls_provider": { "const": false }
      }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "$defs": {
    "package_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "slot_role", "completeness", "output_record_id"],
      "properties": {
        "slot_id": { "type": "string", "minLength": 1 },
        "slot_role": { "type": "string", "enum": ["primary", "supporting"] },
        "completeness": { "type": "string", "enum": ["filled", "missing", "waived"] },
        "output_record_id": { "type": ["string", "null"], "pattern": "^out_[a-zA-Z0-9_-]+$" },
        "waiver_gate_id": { "type": ["string", "null"], "pattern": "^gate_[a-zA-Z0-9_-]+$" },
        "slot_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "caption": { "type": "string" }
          }
        }
      }
    }
  }
}
